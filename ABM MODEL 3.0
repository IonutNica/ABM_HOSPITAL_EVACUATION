;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ROMANIAN UPU EVACUATION ABM — MODEL v3.0
;;
;; AUTHORS
;;   Ionuț Nica
;;   Camelia Delcea
;;   Ștefan Ionescu
;;
;; RELEASE INFORMATION
;;   Version: 3.0
;;   Release date: 2026-10-05
;;   NetLogo version: 7.0.4
;;
;; PURPOSE
;;   Reproducible, ex-ante evaluation of emergency-exit configurations and
;;   feedback-based control mechanisms in a schematic single-floor Romanian
;;   Unitate de Primire Urgențe (UPU).
;;
;;   The model represents patient triage, heterogeneous evacuation mobility,
;;   nursing dependency, preparation processes, local movement conflicts,
;;   congestion-sensitive exit choice, corrective nurse reallocation, and
;;   matched reference-intervention comparisons.
;;
;; MODEL CONTRIBUTIONS AND DESIGN FEATURES
;;   1. Romanian national triage categories
;;      (Red / Yellow / Green / Blue / White) are represented separately from
;;      evacuation mobility classes and nursing-assistance requirements.
;;
;;   2. Two explicit closed-loop control mechanisms are implemented:
;;
;;      a) ROUTE FEEDBACK
;;         observe path distance and current exit congestion
;;         -> compare active-exit costs
;;         -> retain or switch the target exit using hysteresis
;;         -> move agents and update the congestion state.
;;
;;      b) RESOURCE-PRIORITY AND CORRECTIVE REALLOCATION FEEDBACK
;;         observe unresolved patient demand, individual staff waiting,
;;         nurse availability, and en-route deployment
;;         -> calculate a triage-dominant priority score, with waiting-time
;;            and nursing-dependency modifiers
;;         -> dispatch path-feasible nurses
;;         -> replace an en-route nurse when a subsequently available nurse
;;            provides a path-distance gain of at least 0.5 m
;;         -> update assignments and the system state.
;;
;;         Baseline priority weights:
;;           clinical urgency: 10 points per urgency level;
;;           staff waiting: 1 point per minute;
;;           nursing dependency: 2 points per required nurse.
;;
;;         Priority ordering and corrective nurse replacement are distinct
;;         components of the resource-feedback mechanism.
;;
;;   3. Structural exit interventions are evaluated using deterministic
;;      common-random-number seed derivation. Obstacle and population
;;      signatures are audited within matched reference-intervention pairs.
;;      Exact-signature sensitivity results are used when complete signature
;;      concordance is not obtained.
;;
;;   4. Outputs support system-, role-, triage-, and mobility-level analysis.
;;      Recorded measures include all-agent and triage-specific RMET,
;;      completion, censoring, critical delay, observed evacuation times,
;;      exit use, route switches, staff waiting, nurse utilisation,
;;      corrective reallocations, and dispatch distance saved.
;;
;;      The structural analysis uses all-agent and patient-only RMET as
;;      co-primary outcomes under the common 1,800-s horizon.
;;      Patient-only RMET is reconstructed from triage-specific RMET using
;;      the corresponding patient counts. Horizon-capped triage-weighted
;;      time additionally applies the category-specific urgency weights.
;;
;;      P95 is calculated from observed evacuation times among evacuated
;;      agents and is distinct from the horizon-capped RMET outcome.
;;
;;   5. Priority-order diagnostics distinguish the scoring rule from its
;;      realised ordering effects.
;;
;;      At eligible resource reviews, the model compares the static triage
;;      ordering with the dynamic priority ordering under the same state.
;;      Counters record:
;;        - ordering-audit opportunities;
;;        - differences in the complete patient order;
;;        - differences in the top-ranked patient.
;;
;;      A separate deterministic score-level positive control compares
;;      hypothetical same-triage patients with different waiting times and
;;      nursing-team requirements.
;;
;;      This control checks score differentiation. Realised queue-order
;;      differences and corrective reallocations are recorded separately.
;;
;; INTENDED USE
;;   - Offline, ex-ante simulation-based planning and comparative analysis.
;;   - Reproducible evaluation of structural and operational alternatives.
;;   - Research and methodological experimentation.
;;
;;   The model is not a deployed decision-support system, does not receive
;;   live hospital data, and does not provide real-time operational guidance.
;;
;; SCOPE AND INTERPRETATION LIMITS
;;   - "fire-informed" and "earthquake-informed" are behavioural movement
;;     profiles only.
;;
;;   - Fire growth, smoke, heat, toxic exposure, reduced visibility, debris,
;;     structural damage, ground motion, and aftershocks are not physically
;;     simulated.
;;
;;   - Temporary obstacles are generic non-traversable circulation patches;
;;     they are not a physical fire-spread or earthquake-damage model.
;;
;;   - Critical delay is a prolonged-evacuation proxy, not a physical injury,
;;     morbidity, or mortality prediction.
;;
;;   - Bed clearance is represented through a static width constraint and is
;;     not a continuous-space rigid-body transport-device model.
;;
;;   - Absolute evacuation times are model outputs for comparative analysis,
;;     not locally calibrated forecasts for a future evacuation of the focal
;;     hospital.
;;
;; SPATIAL AND TEMPORAL SCALE
;;   - Spatial resolution: 1 patch = 0.5 m.
;;   - Default temporal resolution: 0.25 s/tick.
;;   - Alternative resolution used for convergence testing: 0.125 s/tick.
;;   - Common simulation horizon: 1,800 s.
;;   - Critical-delay threshold: 480 s.
;;
;;   The model verifies that the maximum admissible displacement does not
;;   exceed one patch in a single tick. Fractional movement is retained through
;;   an accumulated movement-credit mechanism.
;;
;; PARAMETERIZATION, CALIBRATION, AND VALIDATION BOUNDARY
;;   - Patient mobility classes, nursing-assistance requirements, team sizes,
;;     and preparation logic are informed structurally by
;;     Haghpanah et al. (2021).
;;
;;   - Bed-assisted, wheelchair, and ambulatory speed and preparation
;;     distributions are parameterized from Geoerg et al. (2025).
;;
;;   - Rahouti et al. (2020) is used as a component-wise cross-source
;;     comparator for ambulatory speed and first-move behaviour; it is not
;;     treated as a global validation verdict.
;;
;;   - The model is literature-parameterized and internally verified but is
;;     not formally calibrated to a drill conducted in the focal Romanian UPU.
;;
;;   - Baseline parameter multipliers are set to 1.0. The parameter-robustness
;;     experiment varies these multipliers to assess sensitivity of the
;;     structural exit contrast, not to fit local evacuation observations.
;;
;;   - Tested robustness levels:
;;       bed-assisted speed:       0.90 / 1.00 / 1.10
;;       wheelchair speed:         0.90 / 1.00 / 1.10
;;       walking speed:            0.90 / 1.00 / 1.10
;;       active preparation time:  0.75 / 1.00 / 1.25
;;       staff response time:      0.75 / 1.00 / 1.25
;;
;;   - Sensitivity perturbations do not constitute local calibration.
;;     Case-specific calibration would require appropriate empirical targets.
;;
;;   - Optional case-specific targets are provided for future calibration;
;;     their availability must not be inferred from literature inputs alone.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

breed [patients patient]
breed [nurses nurse]
breed [doctors doctor]
breed [receptionists receptionist]
breed [visitors visitor]

undirected-link-breed [assistance-links assistance-link]

patches-own [
  cell-kind
  zone
  walkable?
  exit-id
  exit-type
  exit-distances
  wide-exit-distances           ; clearance-aware distances for 2-patch transport units
  anchor-distances

  triage-room-code
  triage-room-target-minutes
  patient-anchor-code
  patient-anchor-priority
  patient-anchor-id
  obstacle-eligible?
]

turtles-own [
  role

  ;; Patient attributes. Triage and mobility are deliberately independent.
  triage-code
  triage-priority
  triage-target-minutes
  mobility-class
  assistance-need             ; none, preferred, required
  assistance-type             ; none, general, special
  assistants-required
  assigned-assistant-whos     ; patient: list of nurse who numbers
  assigned-patient-who        ; nurse: patient who number, or -1
  agent-state                 ; role-specific state machine

  ;; Timing and resource-process attributes.
  preparation-required-s
  preparation-elapsed-s
  preparation-start-s
  first-move-time-s
  waiting-for-staff-s
  alarm-response-s
  preferred-decision-time-s
  busy-time-s

  ;; Movement attributes.
  assisted-speed-mps
  unassisted-speed-mps
  current-speed-mps
  clearance-width-patches
  movement-credit
  previous-patch
  desired-patch
  move-approved?

  target-exit-id
  last-route-cost-m
  route-switch-count

  evacuated?
  censored?
  critical-delay?
  evacuation-time-s
  travelled-distance-m
  exit-used-id

  elderly?
  initial-xcor
  initial-ycor
]

globals [
  meters-per-patch
  seconds-per-tick
  maximum-speed-mps
  large-distance
  number-of-exits
  number-of-patient-anchors
  backtracking-penalty-m
  assistance-team-radius-m

  obstacle-seed
  population-seed

  active-exit-id-list
  realized-obstacle-density-pct
  obstacle-generation-attempts
  initial-population
  current-time-s
  run-complete?
  run-stop-reason
  setup-status
  setup-checkpoint
  verification-status
  scenario-description-text

  patient-anchor-specs
  nurse-starts
  doctor-starts
  receptionist-starts

  resource-assignments-count
  nurse-return-trips
  resource-reallocations-count
  resource-reallocation-distance-saved-m
  resource-reallocation-min-gain-m
  resource-priority-audit-opportunities-count
  resource-priority-order-differences-count
  resource-priority-top-choice-differences-count
  total-nurse-busy-time-s
  obstacle-signature-value
  population-signature-value
  
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REQUIRED INTERFACE GLOBALS
;;
;; scenario-preset, experiment-seed, hazard-condition,
;; existing-door-opening, additional-exits?, adaptive-routing?,
;; resource-feedback?, resource-allocation-rule, case-mix-profile,
;; empirical-variation?, show-agent-labels?, obstacle-density-pct,
;; n-nurses, n-doctors, n-receptionists, left-wing-visitors,
;; hallway-visitors, right-wing-visitors, elderly-visitor-share-pct,
;; speed-multiplier, earthquake-speed-factor,
;; feedback-interval-s, exit-monitor-radius-m,
;; exit-congestion-penalty-m, local-congestion-penalty-m,
;; route-switch-threshold-m, resource-review-interval-s,
;; triage-priority-weight, waiting-time-weight, dependency-weight,
;; preferred-assistance-max-wait-s,
;; bed-speed-cal-factor, wheelchair-speed-cal-factor,
;; walking-speed-cal-factor, active-preparation-cal-factor,
;; staff-response-cal-factor, time-step-s,
;; critical-delay-threshold-s, simulation-horizon-s,
;; target-mean-time-s, target-p95-time-s, target-complete-time-s,
;; target-exit1-share-pct
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to set-default-parameters
  set scenario-preset "S.1.a"
  set experiment-seed 1001
  set hazard-condition "fire-informed"
  set existing-door-opening "fully-open"
  set additional-exits? false

  set adaptive-routing? true
  set resource-feedback? true
  set resource-allocation-rule "cybernetic-priority"
  set case-mix-profile "reference-UPU"
  set empirical-variation? true
  set show-agent-labels? false
  set obstacle-density-pct 10

  set n-nurses 16
  set n-doctors 14
  set n-receptionists 6
  set left-wing-visitors 30
  set hallway-visitors 10
  set right-wing-visitors 100
  set elderly-visitor-share-pct 25

  set speed-multiplier 1
  set earthquake-speed-factor 1.10

  set feedback-interval-s 1
  set exit-monitor-radius-m 3
  set exit-congestion-penalty-m 2
  set local-congestion-penalty-m 0.75
  set route-switch-threshold-m 2

  set resource-review-interval-s 1
  set triage-priority-weight 10
  set waiting-time-weight 1
  set dependency-weight 2
  set preferred-assistance-max-wait-s 60

  set bed-speed-cal-factor 1
  set wheelchair-speed-cal-factor 1
  set walking-speed-cal-factor 1
  set active-preparation-cal-factor 1
  set staff-response-cal-factor 1

  set time-step-s 0.25
  set critical-delay-threshold-s 480
  set simulation-horizon-s 1800

  set target-mean-time-s -1
  set target-p95-time-s -1
  set target-complete-time-s -1
  set target-exit1-share-pct -1

  update-scenario-description
end

to update-resource-waiting-times
  ask patients with [
    not evacuated? and
    not censored? and
    agent-state = "waiting-staff" and
    assistance-need != "none"
  ] [
    set waiting-for-staff-s waiting-for-staff-s + seconds-per-tick
  ]
end

to load-scenario-preset
  if not member? scenario-preset
    ["BASE" "S.1.a" "S.1.b" "S.2.a" "S.2.b"
     "S.3.a" "S.3.b" "S.4.a" "S.4.b"] [
    error "scenario-preset must be BASE or one of S.1.a--S.4.b."
  ]

  if scenario-preset = "BASE" [
    set hazard-condition "no-hazard"
    set existing-door-opening "fully-open"
    set additional-exits? false
    set obstacle-density-pct 0
  ]

  if scenario-preset = "S.1.a" [
    set hazard-condition "fire-informed"
    set existing-door-opening "fully-open"
    set additional-exits? false
  ]
  if scenario-preset = "S.1.b" [
    set hazard-condition "earthquake-informed"
    set existing-door-opening "fully-open"
    set additional-exits? false
  ]
  if scenario-preset = "S.2.a" [
    set hazard-condition "fire-informed"
    set existing-door-opening "partially-open"
    set additional-exits? false
  ]
  if scenario-preset = "S.2.b" [
    set hazard-condition "earthquake-informed"
    set existing-door-opening "partially-open"
    set additional-exits? false
  ]
  if scenario-preset = "S.3.a" [
    set hazard-condition "fire-informed"
    set existing-door-opening "fully-open"
    set additional-exits? true
  ]
  if scenario-preset = "S.3.b" [
    set hazard-condition "earthquake-informed"
    set existing-door-opening "fully-open"
    set additional-exits? true
  ]
  if scenario-preset = "S.4.a" [
    set hazard-condition "fire-informed"
    set existing-door-opening "partially-open"
    set additional-exits? true
  ]
  if scenario-preset = "S.4.b" [
    set hazard-condition "earthquake-informed"
    set existing-door-opening "partially-open"
    set additional-exits? true
  ]

  if scenario-preset != "BASE" and obstacle-density-pct = 0 [
    set obstacle-density-pct 10
  ]

  update-scenario-description
end


to setup-from-preset
  load-scenario-preset
  setup
end


to update-scenario-description
  set scenario-description-text
    (word resolved-article-scenario " | " hazard-condition " | "
          existing-door-opening " | " intervention-label
          " | obstacles=" obstacle-density-pct "% | " case-mix-profile)
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 1. SETUP, INPUT VALIDATION AND FIXED ANCHORS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all

  reset-ticks
  resize-world -63 63 -31 31

  ;; ------------------------------------------------------------
  ;; RUN STATE AND DIAGNOSTICS
  ;; ------------------------------------------------------------
  set run-complete? false
  set run-stop-reason "initialising"
  set setup-status "initialising"
  set setup-checkpoint "start"
  set verification-status "not-run"

  ;; ------------------------------------------------------------
  ;; SPATIAL AND TEMPORAL SCALE
  ;; ------------------------------------------------------------
  set meters-per-patch 0.5
  set seconds-per-tick time-step-s
  set maximum-speed-mps 1.95
  set large-distance 1000000
  set number-of-exits 4
  set number-of-patient-anchors 15
  set backtracking-penalty-m 1
  set assistance-team-radius-m 0.5

  set resource-reallocation-min-gain-m 0.5

  ;; ------------------------------------------------------------
  ;; RESOURCE / OUTPUT COUNTERS
  ;; ------------------------------------------------------------
  set resource-assignments-count 0
  set resource-reallocations-count 0
  set resource-reallocation-distance-saved-m 0
  set nurse-return-trips 0
  set resource-priority-audit-opportunities-count 0
  set resource-priority-order-differences-count 0
  set resource-priority-top-choice-differences-count 0
  set total-nurse-busy-time-s 0

  ;; ------------------------------------------------------------
  ;; INPUTS AND FIXED MODEL STRUCTURE
  ;; ------------------------------------------------------------
  set setup-checkpoint "validate-inputs"
  update-scenario-description
  validate-interface-parameters

  set setup-checkpoint "define-anchors"
  define-fixed-anchors
  derive-stage-seeds

  ;; ------------------------------------------------------------
  ;; SPATIAL ENVIRONMENT
  ;; ------------------------------------------------------------
  set setup-checkpoint "build-spatial-environment"
  setup-spatial-environment

  set setup-checkpoint "generate-obstacles"
  setup-obstacles-with-connectivity-check

  set setup-checkpoint "compute-exit-distance-fields"
  compute-all-exit-distance-fields

  set setup-checkpoint "compute-anchor-distance-fields"
  compute-all-anchor-distance-fields
  identify-active-exits
  validate-exit-accessibility

  ;; ------------------------------------------------------------
  ;; POPULATION
  ;; ------------------------------------------------------------
  set setup-checkpoint "create-population"
  random-seed population-seed
  setup-population

  set setup-checkpoint "validate-population"
  validate-population

  set initial-population count turtles
  set current-time-s 0
  set obstacle-signature-value obstacle-map-signature
  set population-signature-value population-signature
 
  reset-ticks

  set setup-checkpoint "initial-route-choice"
  update-route-choices true
  update-agent-labels

  set setup-checkpoint "verify-state"
  verify-model-state

  set run-complete? false
  set run-stop-reason "running"
  set setup-status "ready"
  set setup-checkpoint "ready"
end


to validate-interface-parameters
  if not member? scenario-preset
    ["BASE" "S.1.a" "S.1.b" "S.2.a" "S.2.b"
     "S.3.a" "S.3.b" "S.4.a" "S.4.b"] [
    error "Invalid scenario-preset."
  ]

  if not member? hazard-condition ["fire-informed" "earthquake-informed" "no-hazard"] [
    error "Invalid hazard-condition."
  ]
  if not member? existing-door-opening ["fully-open" "partially-open" "closed"] [
    error "Invalid existing-door-opening."
  ]
  if not member? resource-allocation-rule ["cybernetic-priority" "triage-only" "FIFO"] [
    error "resource-allocation-rule must be cybernetic-priority, triage-only or FIFO."
  ]
  if not member? case-mix-profile ["reference-UPU" "lower-dependency" "higher-dependency"] [
    error "Invalid case-mix-profile."
  ]

  if experiment-seed < 0 or experiment-seed != floor experiment-seed [
    error "experiment-seed must be a non-negative integer."
  ]
  if obstacle-density-pct < 0 or obstacle-density-pct > 30 or
     obstacle-density-pct != floor obstacle-density-pct [
    error "obstacle-density-pct must be an integer between 0 and 30."
  ]
  if n-nurses < 2 or n-nurses > 16 or n-nurses != floor n-nurses [
    error "n-nurses must be an integer between 2 and 16."
  ]
  if n-doctors < 0 or n-doctors > 14 or n-doctors != floor n-doctors [
    error "n-doctors must be an integer between 0 and 14."
  ]
  if n-receptionists < 0 or n-receptionists > 6 or n-receptionists != floor n-receptionists [
    error "n-receptionists must be an integer between 0 and 6."
  ]
  if left-wing-visitors < 0 or left-wing-visitors > 30 or
     left-wing-visitors != floor left-wing-visitors [
    error "left-wing-visitors must be an integer between 0 and 30."
  ]
  if hallway-visitors < 0 or hallway-visitors > 10 or
     hallway-visitors != floor hallway-visitors [
    error "hallway-visitors must be an integer between 0 and 10."
  ]
  if right-wing-visitors < 0 or right-wing-visitors > 100 or
     right-wing-visitors != floor right-wing-visitors [
    error "right-wing-visitors must be an integer between 0 and 100."
  ]
  if elderly-visitor-share-pct < 0 or elderly-visitor-share-pct > 100 [
    error "elderly-visitor-share-pct must be between 0 and 100."
  ]

  if speed-multiplier <= 0 or earthquake-speed-factor <= 0 [
    error "Speed factors must be positive."
  ]
  if bed-speed-cal-factor <= 0 or wheelchair-speed-cal-factor <= 0 or
     walking-speed-cal-factor <= 0 or active-preparation-cal-factor <= 0 or
     staff-response-cal-factor <= 0 [
    error "Calibration factors must be positive."
  ]
  if not member? time-step-s [0.125 0.25] [
    error "time-step-s must be 0.125 or 0.25 seconds."
  ]
  if maximum-speed-mps * time-step-s > meters-per-patch [
    error "The selected time step permits movement exceeding one patch per tick."
  ]

  if feedback-interval-s <= 0 or resource-review-interval-s <= 0 [
    error "Feedback intervals must be positive."
  ]
  if exit-monitor-radius-m <= 0 [error "exit-monitor-radius-m must be positive."]
  if exit-congestion-penalty-m < 0 or local-congestion-penalty-m < 0 or
     route-switch-threshold-m < 0 [
    error "Route-feedback penalties cannot be negative."
  ]
  if triage-priority-weight < 0 or waiting-time-weight < 0 or dependency-weight < 0 [
    error "Resource-priority weights cannot be negative."
  ]
  if preferred-assistance-max-wait-s < 0 [
    error "preferred-assistance-max-wait-s cannot be negative."
  ]
  if critical-delay-threshold-s <= 0 or simulation-horizon-s <= critical-delay-threshold-s [
    error "The horizon must exceed the positive critical-delay threshold."
  ]
  if existing-door-opening = "closed" and not additional-exits? [
    error "No active exit would remain."
  ]
end

to-report assigned-patient-resource-priority  

  if role != "nurse" [report -1]
  if assigned-patient-who < 0 [report -1]

  let dependent turtle assigned-patient-who

  if dependent = nobody [report -1]
  if [evacuated? or censored?] of dependent [report -1]

  report [resource-priority-score] of dependent
end

to rebalance-nursing-resources
  
  if not resource-feedback? [stop]

  let unresolved-required patients with [
    not evacuated? and
    not censored? and
    assistance-need = "required" and
    agent-state = "waiting-staff" and
    length assigned-assistant-whos >= assistants-required and
    not full-assistance-team-at-patient?
  ]

  if not any? unresolved-required [stop]

  let ordered-urgent sort-by
    [[a b] -> patient-higher-resource-priority? a b]
    unresolved-required

  foreach ordered-urgent [urgent ->
    let urgent-anchor-id [[patient-anchor-id] of patch-here] of urgent

    if urgent-anchor-id > 0 [
      let urgent-nurses [assigned-nurse-agentset] of urgent
      let dispatched-team urgent-nurses with [agent-state = "dispatched"]

      if any? dispatched-team [
        let far-nurse max-one-of dispatched-team [
          [distance-to-anchor-patches urgent-anchor-id] of patch-here
        ]
        let far-distance
          [[distance-to-anchor-patches urgent-anchor-id] of patch-here] of far-nurse

     
        let available-candidates nurses with [
          agent-state = "available" and
          assigned-patient-who = -1 and
          not evacuated? and
          not censored? and
          [distance-to-anchor-patches urgent-anchor-id] of patch-here < large-distance
        ]

        if any? available-candidates [
          let near-nurse min-one-of available-candidates [
            [distance-to-anchor-patches urgent-anchor-id] of patch-here
          ]
          let near-distance
            [[distance-to-anchor-patches urgent-anchor-id] of patch-here] of near-nurse

          let gain-m (far-distance - near-distance) * meters-per-patch

          if gain-m >= resource-reallocation-min-gain-m [
            let urgent-who [who] of urgent
            let far-who [who] of far-nurse
            let near-who [who] of near-nurse

     
            ask urgent [
              set assigned-assistant-whos
                remove far-who assigned-assistant-whos
              set assigned-assistant-whos
                lput near-who assigned-assistant-whos
            ]

           
            ask assistance-links with [
              (end1 = urgent and end2 = far-nurse) or
              (end1 = far-nurse and end2 = urgent)
            ] [
              die
            ]

            ask urgent [
              create-assistance-link-with near-nurse [
                set color pink
                set thickness 0.12
                set hidden? false
              ]
            ]

        
            ask near-nurse [
              set assigned-patient-who urgent-who
              set agent-state "dispatched"
              set target-exit-id 0
              set last-route-cost-m large-distance
              set desired-patch nobody
              set move-approved? false
              set previous-patch nobody
            ]


            ask far-nurse [
              set assigned-patient-who -1
              set agent-state "available"
              set target-exit-id 0
              set last-route-cost-m large-distance
              set desired-patch nobody
              set move-approved? false
              set previous-patch nobody
            ]

            set resource-reallocations-count
              resource-reallocations-count + 1
            set resource-reallocation-distance-saved-m
              resource-reallocation-distance-saved-m + gain-m
          ]
        ]
      ]
    ]
  ]
end

to define-fixed-anchors

  set patient-anchor-specs [
    [-45  26 "red"    1  1]
    [-45  21 "red"    1  2]
    [-54  11 "yellow" 2  3]
    [-45  15 "yellow" 2  4]
    [-45  10 "yellow" 2  5]
    [-54   0 "green"  3  6]
    [-45   4 "green"  3  7]
    [-45  -1 "green"  3  8]
    [-54 -11 "blue"   4  9]
    [-45  -7 "blue"   4 10]
    [-45 -12 "blue"   4 11]
    [-51 -18 "white"  5 12]
    [-45 -18 "white"  5 13]
    [-51 -23 "white"  5 14]
    [-45 -23 "white"  5 15]
  ]

  set nurse-starts [
    [-44 26] [-44 21] [-54 10] [-44 15] [-44 10]
    [-54 -1] [-44 4] [-44 -1] [-54 -13] [-44 -7] [-44 -18]
    [12 -5] [27 -5] [42 -5] [6 -6] [21 -6]
  ]

  set doctor-starts [
    [-52 24] [-49 24] [-52 13] [-49 13] [-52 2] [-49 2]
    [-52 -9] [-49 -9] [-52 -20] [-49 -20]
    [11 -1] [26 -1] [37 0] [49 0]
  ]

  set receptionist-starts [
    [3 9] [3 10] [3 11] [53 9] [53 10] [53 11]
  ]
end


to derive-stage-seeds
  set obstacle-seed ((experiment-seed * 1009 + 101) mod 2147483647)
  set population-seed ((experiment-seed * 1013 + 211) mod 2147483647)
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 2. SPATIAL ENVIRONMENT
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to setup-spatial-environment
  ask patches [initialise-patch]

  build-floor-footprint
  assign-spatial-zones
  build-outer-walls
  build-triage-rooms
  build-consultation-area
  build-receptions
  build-static-furniture
  configure-exits
  mark-obstacle-eligible-patches
end


to initialise-patch  ;; patch procedure
  set cell-kind "outside"
  set zone "outside"
  set walkable? false
  set exit-id 0
  set exit-type "none"
  set exit-distances (n-values number-of-exits [i -> large-distance])
  set wide-exit-distances (n-values number-of-exits [i -> large-distance])
  set anchor-distances (n-values number-of-patient-anchors [i -> large-distance])
  set triage-room-code ""
  set triage-room-target-minutes -1
  set patient-anchor-code ""
  set patient-anchor-priority 0
  set patient-anchor-id 0
  set obstacle-eligible? false
  set pcolor white
  set plabel ""
end


to build-floor-footprint
  ask patches with [
    ((pxcor >= -56 and pxcor <= 5) and (pycor >= -30 and pycor <= 29)) or
    ((pxcor >= 5 and pxcor <= 51) and (pycor >= -23 and pycor <= 1)) or
    ((pxcor >= 51 and pxcor <= 63) and (pycor >= -30 and pycor <= 28))
  ] [
    set-floor-patch
  ]
end


to assign-spatial-zones
  ask patches with [cell-kind = "floor"] [
    if pxcor >= -55 and pxcor <= -44 and pycor >= 19 and pycor <= 28 [
      set zone "triage-red"
      set triage-room-code "red"
      set triage-room-target-minutes 0
      set pcolor (triage-room-color "red")
    ]

    if pxcor >= -55 and pxcor <= -44 and pycor >= 8 and pycor <= 17 [
      set zone "triage-yellow"
      set triage-room-code "yellow"
      set triage-room-target-minutes 15
      set pcolor (triage-room-color "yellow")
    ]

    if pxcor >= -55 and pxcor <= -44 and pycor >= -3 and pycor <= 6 [
      set zone "triage-green"
      set triage-room-code "green"
      set triage-room-target-minutes 60
      set pcolor (triage-room-color "green")
    ]

    if pxcor >= -55 and pxcor <= -44 and pycor >= -14 and pycor <= -5 [
      set zone "triage-blue"
      set triage-room-code "blue"
      set triage-room-target-minutes 120
      set pcolor (triage-room-color "blue")
    ]

    if pxcor >= -55 and pxcor <= -44 and pycor >= -25 and pycor <= -16 [
      set zone "triage-white"
      set triage-room-code "white"
      set triage-room-target-minutes 240
      set pcolor (triage-room-color "white")
    ]

    if pxcor >= -42 and pxcor <= 4 and pycor >= -29 and pycor <= 28 [
      set zone "left-hall"
    ]

    if pxcor >= 6 and pxcor <= 50 and pycor >= -9 and pycor <= 0 [
      set zone "consultation-room"
    ]

    if pxcor >= 6 and pxcor <= 50 and pycor >= -22 and pycor <= -11 [
      set zone "central-corridor"
    ]

    if pxcor >= 52 and pxcor <= 62 and pycor >= -29 and pycor <= 27 [
      set zone "right-hall"
    ]
  ]
end


to-report triage-room-color [code-value]
  if code-value = "red" [report red + 3.5]
  if code-value = "yellow" [report yellow + 3.5]
  if code-value = "green" [report green + 3.5]
  if code-value = "blue" [report blue + 3.5]
  if code-value = "white" [report white]
  report gray
end


to-report triage-target-minutes-for [code-value]
  if code-value = "red" [report 0]
  if code-value = "yellow" [report 15]
  if code-value = "green" [report 60]
  if code-value = "blue" [report 120]
  if code-value = "white" [report 240]
  report -1
end


to-report triage-priority-for [code-value]
  if code-value = "red" [report 1]
  if code-value = "yellow" [report 2]
  if code-value = "green" [report 3]
  if code-value = "blue" [report 4]
  if code-value = "white" [report 5]
  report 0
end


to-report triage-code-label [code-value]
  if code-value = "red" [report "R"]
  if code-value = "yellow" [report "Y"]
  if code-value = "green" [report "G"]
  if code-value = "blue" [report "B"]
  if code-value = "white" [report "W"]
  report ""
end


to build-outer-walls
  ;; Left wing perimeter.
  ask patches with [pxcor = -56 and pycor >= -30 and pycor <= 29] [set-wall-patch]
  ask patches with [pxcor = 5 and pycor >= -30 and pycor <= 29] [set-wall-patch]
  ask patches with [pycor = 29 and pxcor >= -56 and pxcor <= 5] [set-wall-patch]
  ask patches with [pycor = -30 and pxcor >= -56 and pxcor <= 5] [set-wall-patch]

  ;; Central connector perimeter.
  ask patches with [pycor = 1 and pxcor >= 5 and pxcor <= 51] [set-wall-patch]
  ask patches with [pycor = -23 and pxcor >= 5 and pxcor <= 51] [set-wall-patch]

  ;; Right wing perimeter.
  ask patches with [pxcor = 51 and pycor >= -30 and pycor <= 28] [set-wall-patch]
  ask patches with [pxcor = 63 and pycor >= -30 and pycor <= 28] [set-wall-patch]
  ask patches with [pycor = 28 and pxcor >= 51 and pxcor <= 63] [set-wall-patch]
  ask patches with [pycor = -30 and pxcor >= 51 and pxcor <= 63] [set-wall-patch]

  ;; Internal connectors between wings.
  ask patches with [pxcor = 5 and pycor >= -20 and pycor <= -13] [
    set-intermediate-door-patch
  ]
  ask patches with [pxcor = 51 and pycor >= -20 and pycor <= -13] [
    set-intermediate-door-patch
  ]
end


to build-triage-rooms
  ask patches with [pxcor = -43 and pycor >= -26 and pycor <= 28] [set-wall-patch]

  foreach [18 7 -4 -15 -26] [y-value ->
    ask patches with [pycor = y-value and pxcor >= -55 and pxcor <= -43] [
      set-wall-patch
    ]
  ]

  ;; Triage-room doors.
  ask patches with [pxcor = -43 and pycor >= 23 and pycor <= 25] [set-intermediate-door-patch]
  ask patches with [pxcor = -43 and pycor >= 12 and pycor <= 14] [set-intermediate-door-patch]
  ask patches with [pxcor = -43 and pycor >= 1 and pycor <= 3] [set-intermediate-door-patch]
  ask patches with [pxcor = -43 and pycor >= -10 and pycor <= -8] [set-intermediate-door-patch]
  ask patches with [pxcor = -43 and pycor >= -21 and pycor <= -19] [set-intermediate-door-patch]

  ;; Bed footprints.
  mark-bed-rectangle -48 -45 26 27
  mark-bed-rectangle -48 -45 20 21

  mark-bed-rectangle -54 -53 11 14
  mark-bed-rectangle -48 -45 15 16
  mark-bed-rectangle -48 -45 9 10

  mark-bed-rectangle -54 -53 0 3
  mark-bed-rectangle -48 -45 4 5
  mark-bed-rectangle -48 -45 -2 -1

  mark-bed-rectangle -54 -53 -11 -8
  mark-bed-rectangle -48 -45 -7 -6
  mark-bed-rectangle -48 -45 -13 -12

  mark-bed-rectangle -54 -51 -18 -17
  mark-bed-rectangle -48 -45 -18 -17
  mark-bed-rectangle -54 -51 -24 -23
  mark-bed-rectangle -48 -45 -24 -23


  foreach patient-anchor-specs [spec ->
    let anchor patch (item 0 spec) (item 1 spec)
    let code-value item 2 spec
    let priority-value item 3 spec
    ask anchor [
      set cell-kind "patient-start"
      set walkable? true
      set patient-anchor-code code-value
      set patient-anchor-priority priority-value
      set patient-anchor-id (item 4 spec)
      set zone (word "triage-" code-value)
      set triage-room-code code-value
      set triage-room-target-minutes (triage-target-minutes-for code-value)
      set pcolor (triage-room-color code-value)
    ]
  ]
end




to build-consultation-area
  ask patches with [pycor = -10 and pxcor >= 6 and pxcor <= 50] [set-wall-patch]
  ask patches with [pxcor = 20 and pycor >= -9 and pycor <= 1] [set-wall-patch]
  ask patches with [pxcor = 35 and pycor >= -9 and pycor <= 1] [set-wall-patch]

  ask patches with [pycor = -10 and pxcor >= 13 and pxcor <= 16] [set-intermediate-door-patch]
  ask patches with [pycor = -10 and pxcor >= 28 and pxcor <= 31] [set-intermediate-door-patch]
  ask patches with [pycor = -10 and pxcor >= 44 and pxcor <= 47] [set-intermediate-door-patch]
end


to build-receptions
  ask patches with [pxcor = 2 and pycor >= 6 and pycor <= 15] [set-wall-patch]
  ask patches with [pycor = 15 and pxcor >= 2 and pxcor <= 4] [set-wall-patch]

  ask patches with [pycor = 15 and pxcor >= 52 and pxcor <= 54] [set-wall-patch]
  ask patches with [pxcor = 54 and pycor >= 6 and pycor <= 15] [set-wall-patch]

  foreach receptionist-starts [xy ->
    ask patch (item 0 xy) (item 1 xy) [
      set cell-kind "floor"
      set walkable? true
      set zone "reception"
      set pcolor 37
    ]
  ]
end


to build-static-furniture
  ;; Open-hall stretchers and chairs.
  mark-furniture-rectangle -30 -29 24 27 "bed"
  mark-furniture-rectangle -20 -19 22 25 "bed"
  ask patches with [pycor = -29 and pxcor >= -25 and pxcor <= 4 and pxcor mod 2 = 0] [
    set-furniture-patch
  ]

  ;; Central-corridor furniture.
  mark-furniture-rectangle 10 13 -22 -21 "bed"
  mark-furniture-rectangle 16 19 -22 -21 "bed"
  ask patches with [pycor = -22 and pxcor >= 30 and pxcor <= 43 and pxcor mod 2 = 0] [
    set-furniture-patch
  ]

  ;; Consultation-room equipment and desks.
  mark-furniture-rectangle 7 8 -9 -6 "bed"
  mark-furniture-rectangle 10 12 -3 -2 "furniture"
  mark-furniture-rectangle 22 23 -9 -6 "bed"
  mark-furniture-rectangle 25 27 -3 -2 "furniture"
  mark-furniture-rectangle 36 36 -9 -7 "furniture"
  mark-furniture-rectangle 36 38 -2 -1 "furniture"
  mark-furniture-rectangle 48 50 -2 -1 "furniture"
end


to configure-exits
  ;; Existing exit 1: bottom of left wing; full width 8 patches = 4 m.
  let left-existing-width 0
  if existing-door-opening = "fully-open" [set left-existing-width 8]
  if existing-door-opening = "partially-open" [set left-existing-width 4]
  open-horizontal-exit -35 -30 left-existing-width 1 "existing"

  ;; Existing exit 2: top of right wing; full width 4 patches = 2 m.
  let right-existing-width 0
  if existing-door-opening = "fully-open" [set right-existing-width 4]
  if existing-door-opening = "partially-open" [set right-existing-width 2]
  open-horizontal-exit 60 28 right-existing-width 2 "existing"

  ;; Proposed exits: top of left wing and bottom of right wing, each 2 m.
  if additional-exits? [
    open-horizontal-exit -26 29 4 3 "proposed"
    open-horizontal-exit 56 -30 4 4 "proposed"
  ]

  identify-active-exits
end


to open-horizontal-exit [start-x y-value width-in-patches id-value type-value]
  if width-in-patches > 0 [
    ask patches with [
      pycor = y-value and
      pxcor >= start-x and
      pxcor < start-x + width-in-patches
    ] [
      set cell-kind "door"
      set walkable? true
      set exit-id id-value
      set exit-type type-value
      ifelse type-value = "existing"
        [set pcolor green]
        [set pcolor violet]
    ]
  ]
end


to set-floor-patch  ;; patch procedure
  set cell-kind "floor"
  set walkable? true
  set exit-id 0
  set exit-type "none"
  set pcolor 97
end


to set-wall-patch  ;; patch procedure
  set cell-kind "wall"
  set walkable? false
  set exit-id 0
  set exit-type "none"
  set pcolor black
end


to set-intermediate-door-patch  ;; patch procedure
  set cell-kind "intermediate-door"
  set walkable? true
  set exit-id 0
  set exit-type "none"
  set pcolor turquoise
end


to set-furniture-patch  ;; patch procedure
  set cell-kind "furniture"
  set walkable? false
  set exit-id 0
  set exit-type "none"
  set pcolor brown
end


to mark-bed-rectangle [xmin xmax ymin ymax]
  ask patches with [
    pxcor >= xmin and pxcor <= xmax and
    pycor >= ymin and pycor <= ymax
  ] [
    set cell-kind "bed"
    set walkable? false
    set exit-id 0
    set exit-type "none"
    set pcolor gray + 1
  ]
end


to mark-furniture-rectangle [xmin xmax ymin ymax kind-value]
  ask patches with [
    pxcor >= xmin and pxcor <= xmax and
    pycor >= ymin and pycor <= ymax
  ] [
    ifelse kind-value = "bed"
      [
        set cell-kind "bed"
        set pcolor gray + 1
      ]
      [
        set cell-kind "furniture"
        set pcolor brown
      ]
    set walkable? false
    set exit-id 0
    set exit-type "none"
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 3. EXACT-DENSITY OBSTACLES AND CONNECTIVITY
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to mark-obstacle-eligible-patches
  ask patches [set obstacle-eligible? false]

  ask patches with [
    cell-kind = "floor" and
    member? zone ["left-hall" "central-corridor" "right-hall"] and
    not reserved-for-egress-or-initialisation?
  ] [
    set obstacle-eligible? true
  ]
end


to-report reserved-for-egress-or-initialisation?  ;; patch reporter
 
  if distancexy -31.5 -30 <= 4 [report true]
  if distancexy 61.5 28 <= 4 [report true]
  if distancexy -24.5 29 <= 4 [report true]
  if distancexy 57.5 -30 <= 4 [report true]

  if any? patches in-radius 2 with [cell-kind = "intermediate-door"] [report true]
  if any? patches in-radius 2 with [patient-anchor-id > 0] [report true]

  let reserved? false
  foreach nurse-starts [xy ->
    if distancexy (item 0 xy) (item 1 xy) <= 1.5 [set reserved? true]
  ]
  foreach doctor-starts [xy ->
    if distancexy (item 0 xy) (item 1 xy) <= 1.5 [set reserved? true]
  ]
  foreach receptionist-starts [xy ->
    if distancexy (item 0 xy) (item 1 xy) <= 1 [set reserved? true]
  ]
  report reserved?
end


to setup-obstacles-with-connectivity-check
  set obstacle-generation-attempts 0
  let accepted? false


  let max-attempts 5000

  while [
    not accepted? and
    obstacle-generation-attempts < max-attempts
  ] [
    set obstacle-generation-attempts
      obstacle-generation-attempts + 1

    clear-temporary-obstacles

    random-seed
      ((obstacle-seed + obstacle-generation-attempts - 1)
        mod 2147483647)

    generate-temporary-obstacles
    compute-all-exit-distance-fields

    set accepted? (
      patient-anchors-have-valid-route? and
      staff-anchors-have-valid-route? and
      visitor-zones-have-sufficient-capacity?
    )
  ]

  if not accepted? [
    error
      (word
        "Unable to generate a connected exact-density obstacle map. "
        "scenario=" resolved-article-scenario
        ", experiment-seed=" experiment-seed
        ", obstacle-density-pct=" obstacle-density-pct
        ", attempts=" obstacle-generation-attempts)
  ]

  let eligible-count count patches with [obstacle-eligible?]

  ifelse eligible-count > 0
  [
    set realized-obstacle-density-pct
      100 *
      count patches with [cell-kind = "temporary-obstacle"] /
      eligible-count
  ]
  [
    set realized-obstacle-density-pct 0
  ]
end


to clear-temporary-obstacles
  ask patches with [cell-kind = "temporary-obstacle"] [
    set-floor-patch
  ]
end


to generate-temporary-obstacles

  let eligible patches with [obstacle-eligible?]
  let target-count round ((obstacle-density-pct / 100) * count eligible)

  if target-count > 0 [
    ask n-of target-count eligible [
      set cell-kind "temporary-obstacle"
      set walkable? false
      set pcolor orange
    ]
  ]
end


to-report connectivity-exit-ids

  let result active-existing-exit-ids
  if empty? result [set result active-exit-id-list]
  report result
end


to-report patient-anchors-have-valid-route?
  let connectivity-exits connectivity-exit-ids
  if empty? connectivity-exits [report false]

  let valid? true
  foreach patient-anchor-specs [spec ->
    let start-patch patch (item 0 spec) (item 1 spec)
    let anchor-id-value item 4 spec
    let class-value mobility-class-for-anchor anchor-id-value
    let required-width ifelse-value
      member? class-value ["high-acuity-bed" "low-acuity-bed"] [2] [1]

    if not [route-to-any-exit-for-width? connectivity-exits required-width] of start-patch [
      set valid? false
    ]
  ]
  report valid?
end


to-report staff-anchors-have-valid-route?
  let connectivity-exits connectivity-exit-ids
  if empty? connectivity-exits [report false]

  let valid? true
  foreach nurse-starts [xy ->
    let start-patch patch (item 0 xy) (item 1 xy)
    if not [walkable?] of start-patch [set valid? false]
    if not [route-to-any-exit? connectivity-exits] of start-patch [set valid? false]
  ]
  foreach doctor-starts [xy ->
    let start-patch patch (item 0 xy) (item 1 xy)
    if not [walkable?] of start-patch [set valid? false]
    if not [route-to-any-exit? connectivity-exits] of start-patch [set valid? false]
  ]
  foreach receptionist-starts [xy ->
    let start-patch patch (item 0 xy) (item 1 xy)
    if not [walkable?] of start-patch [set valid? false]
    if not [route-to-any-exit? connectivity-exits] of start-patch [set valid? false]
  ]
  report valid?
end


to-report visitor-zones-have-sufficient-capacity?
  let connectivity-exits connectivity-exit-ids
  if empty? connectivity-exits [report false]

  let left-capacity count patches with [
    walkable? and zone = "left-hall" and exit-id = 0 and
    patient-anchor-id = 0 and not reserved-for-egress-or-initialisation? and
    route-to-any-exit? connectivity-exits
  ]

  let hallway-capacity count patches with [
    walkable? and zone = "central-corridor" and exit-id = 0 and
    patient-anchor-id = 0 and not reserved-for-egress-or-initialisation? and
    route-to-any-exit? connectivity-exits
  ]

  let right-capacity count patches with [
    walkable? and zone = "right-hall" and exit-id = 0 and
    patient-anchor-id = 0 and not reserved-for-egress-or-initialisation? and
    route-to-any-exit? connectivity-exits
  ]

  report (
    left-capacity >= left-wing-visitors and
    hallway-capacity >= hallway-visitors and
    right-capacity >= right-wing-visitors
  )
end


to-report route-to-any-exit? [id-list]  ;; patch reporter
  report route-to-any-exit-for-width? id-list 1
end


to-report route-to-any-exit-for-width? [id-list required-width]  ;; patch reporter
  let reachable? false
  foreach id-list [id-value ->
    if distance-to-exit-patches-for-width id-value required-width < large-distance [
      set reachable? true
    ]
  ]
  report reachable?
end


to-report active-existing-exit-ids
  let result []
  if any? patches with [exit-id = 1 and walkable?] [set result (lput 1 result)]
  if any? patches with [exit-id = 2 and walkable?] [set result (lput 2 result)]
  report result
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 4. DISTANCE FIELDS, ROUTE FEEDBACK AND ACCESSIBILITY
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to identify-active-exits
  set active-exit-id-list []
  foreach (range 1 (number-of-exits + 1)) [id-value ->
    if any? patches with [exit-id = id-value and walkable?] [
      set active-exit-id-list (lput id-value active-exit-id-list)
    ]
  ]
end


to compute-all-exit-distance-fields
  identify-active-exits
  foreach (range 1 (number-of-exits + 1)) [id-value ->
    compute-exit-distance-field id-value
    compute-wide-exit-distance-field id-value
  ]
end


to compute-exit-distance-field [id-value]
  let field-index id-value - 1
  ask patches [
    set exit-distances (replace-item field-index exit-distances large-distance)
  ]
  ask patches with [exit-id = id-value and walkable?] [
    set exit-distances (replace-item field-index exit-distances 0)
  ]

  let frontier patches with [item field-index exit-distances = 0]
  let distance-level 0
  while [any? frontier] [
    let current-frontier frontier
    ask current-frontier [
      ask neighbors4 with [
        walkable? and item field-index exit-distances = large-distance
      ] [
        set exit-distances
          replace-item field-index exit-distances (distance-level + 1)
      ]
    ]
    set distance-level distance-level + 1
    set frontier patches with [item field-index exit-distances = distance-level]
  ]
end



to compute-wide-exit-distance-field [id-value]
  let field-index id-value - 1

 
  ask patches [
    set wide-exit-distances
      (replace-item field-index wide-exit-distances large-distance)
  ]

  let exit-width-patches count patches with [
    exit-id = id-value and walkable?
  ]

  if exit-width-patches >= 2 [

    ask patches with [exit-id = id-value and walkable?] [
      set wide-exit-distances
        (replace-item field-index wide-exit-distances 0)
    ]

    let distance-level 0
    let frontier patches with [
      item field-index wide-exit-distances = 0
    ]

    while [any? frontier] [
      let current-frontier frontier

      ask patches with [
        walkable? and
        item field-index wide-exit-distances = large-distance
      ] [
        let origin self
        let feasible-destination? false

        foreach sort neighbors4 [destination ->
          if [item field-index wide-exit-distances] of destination = distance-level [
            if [static-destination-clear-for-width? origin 2] of destination [
              set feasible-destination? true
            ]
          ]
        ]

        if feasible-destination? [
          set wide-exit-distances
            (replace-item field-index wide-exit-distances (distance-level + 1))
        ]
      ]

      set distance-level distance-level + 1
      set frontier patches with [
        item field-index wide-exit-distances = distance-level
      ]
    ]
  ]
end


to-report static-destination-clear-for-width? [origin-patch required-width]  ;; patch reporter
  if required-width <= 1 [report true]

  if not walkable? [report false]

  if exit-id > 0 [
    report count patches with [
      exit-id = [exit-id] of myself and walkable?
    ] >= required-width
  ]

  let delta-x pxcor - [pxcor] of origin-patch
  let delta-y pycor - [pycor] of origin-patch

  if delta-x != 0 [
    let north patch-at 0 1
    let south patch-at 0 -1
    report (
      (north != nobody and [walkable?] of north) or
      (south != nobody and [walkable?] of south)
    )
  ]

  if delta-y != 0 [
    let east patch-at 1 0
    let west patch-at -1 0
    report (
      (east != nobody and [walkable?] of east) or
      (west != nobody and [walkable?] of west)
    )
  ]

  report true
end


to compute-all-anchor-distance-fields
  foreach patient-anchor-specs [spec ->
    compute-anchor-distance-field (item 4 spec) (item 0 spec) (item 1 spec)
  ]
end


to compute-anchor-distance-field [anchor-id-value anchor-x anchor-y]
  let field-index anchor-id-value - 1
  ask patches [
    set anchor-distances (replace-item field-index anchor-distances large-distance)
  ]

  let anchor-patch patch anchor-x anchor-y
  ask anchor-patch [
    set anchor-distances (replace-item field-index anchor-distances 0)
  ]

  let frontier patch-set anchor-patch
  let distance-level 0
  while [any? frontier] [
    let current-frontier frontier
    ask current-frontier [
      ask neighbors4 with [
        walkable? and item field-index anchor-distances = large-distance
      ] [
        set anchor-distances
          replace-item field-index anchor-distances (distance-level + 1)
      ]
    ]
    set distance-level distance-level + 1
    set frontier patches with [item field-index anchor-distances = distance-level]
  ]
end


to validate-exit-accessibility
  if empty? active-exit-id-list [error "The configuration contains no active exit."]
  if not patient-anchors-have-valid-route? [
    error "At least one patient anchor has no route to an active exit."
  ]
end


to update-route-choices [force-update?]
  let feedback-ticks max (list 1 (round (feedback-interval-s / seconds-per-tick)))
  if not (force-update? or ticks mod feedback-ticks = 0) [stop]

  foreach sort (turtles with [needs-exit-route?]) [agent ->
    ask agent [select-exit-using-feedback force-update?]
  ]

  ask nurses with [agent-state = "escorting" and assigned-patient-who >= 0] [
    let dependent turtle assigned-patient-who
    if dependent != nobody [
      set target-exit-id [target-exit-id] of dependent
      set last-route-cost-m [last-route-cost-m] of dependent
    ]
  ]
end


to-report needs-exit-route?  ;; turtle reporter
  if evacuated? or censored? [report false]
  if role = "patient" [
    report member? agent-state ["self-evacuating" "evacuating"]
  ]
  if role = "nurse" [report agent-state = "self-evacuating"]
  report agent-state = "self-evacuating"
end


to select-exit-using-feedback [force-update?]  ;; turtle procedure
  if empty? active-exit-id-list [stop]

  let feasible-ids filter [id-value -> exit-accessible-to-agent? id-value] active-exit-id-list
  if empty? feasible-ids [
    set target-exit-id 0
    set last-route-cost-m large-distance
    stop
  ]

  let best-id first feasible-ids
  let best-cost exit-choice-cost-m best-id
  foreach but-first feasible-ids [id-value ->
    let candidate-cost exit-choice-cost-m id-value
    if candidate-cost < best-cost [
      set best-id id-value
      set best-cost candidate-cost
    ]
  ]

  ifelse target-exit-id = 0 or not member? target-exit-id feasible-ids
    [
      set target-exit-id best-id
      set last-route-cost-m best-cost
    ]
    [
      let current-cost exit-choice-cost-m target-exit-id
      ifelse adaptive-routing?
        [
          if force-update? or best-id = target-exit-id or
             best-cost + route-switch-threshold-m < current-cost [
            if best-id != target-exit-id [
              set target-exit-id best-id
              set route-switch-count route-switch-count + 1
            ]
            set last-route-cost-m best-cost
          ]
        ]
        [
          if force-update? [
            set target-exit-id best-id
            set last-route-cost-m best-cost
          ]
        ]
    ]
end


to-report exit-accessible-to-agent? [id-value]  ;; turtle reporter
  if not member? id-value active-exit-id-list [report false]

  let required-width clearance-width-patches
  let width-patches count patches with [exit-id = id-value and walkable?]
  if width-patches < required-width [report false]

  report [distance-to-exit-patches-for-width id-value required-width] of patch-here <
    large-distance
end


to-report exit-choice-cost-m [id-value]  ;; turtle reporter
  let required-width clearance-width-patches
  let path-distance
    [distance-to-exit-m-for-width id-value required-width] of patch-here
  if path-distance >= large-distance [report large-distance]
  let queue-pressure exit-congestion-pressure id-value
  report path-distance + exit-congestion-penalty-m * queue-pressure
end


to-report exit-congestion-pressure [id-value]
  let exit-patches patches with [exit-id = id-value and walkable?]
  if not any? exit-patches [report large-distance]

  let centre-x mean [pxcor] of exit-patches
  let centre-y mean [pycor] of exit-patches
  let radius-in-patches exit-monitor-radius-m / meters-per-patch

  let crowd count turtles with [
    not evacuated? and not censored? and occupies-physical-space? and
    distancexy centre-x centre-y <= radius-in-patches
  ]

  let width-m count exit-patches * meters-per-patch
  if width-m <= 0 [report large-distance]
  report crowd / width-m
end


to-report distance-to-exit-patches [id-value]  ;; patch reporter
  if id-value < 1 or id-value > number-of-exits [report large-distance]
  report item (id-value - 1) exit-distances
end


to-report distance-to-exit-m [id-value]  ;; patch reporter
  let d distance-to-exit-patches id-value
  if d >= large-distance [report large-distance]
  report d * meters-per-patch
end


to-report distance-to-exit-patches-for-width [id-value required-width]  ;; patch reporter
  if id-value < 1 or id-value > number-of-exits [report large-distance]
  if required-width <= 1 [report distance-to-exit-patches id-value]
  report item (id-value - 1) wide-exit-distances
end


to-report distance-to-exit-m-for-width [id-value required-width]  ;; patch reporter
  let d distance-to-exit-patches-for-width id-value required-width
  if d >= large-distance [report large-distance]
  report d * meters-per-patch
end


to-report distance-to-anchor-patches [anchor-id-value]  ;; patch reporter
  if anchor-id-value < 1 or anchor-id-value > number-of-patient-anchors [
    report large-distance
  ]
  report item (anchor-id-value - 1) anchor-distances
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 5. POPULATION, PATIENT CASE MIX AND PARAMETERISATION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to setup-population
  set-default-shape turtles "person"

  create-patient-agents
  create-nurse-agents
  create-doctor-agents
  create-receptionist-agents
  create-visitor-agents

  ask turtles [
    set initial-xcor xcor
    set initial-ycor ycor
  ]
end


to create-patient-agents
  foreach patient-anchor-specs [spec ->
    let start-patch patch (item 0 spec) (item 1 spec)
    let code-value item 2 spec
    let priority-value item 3 spec
    let anchor-id-value item 4 spec

    ask start-patch [
      sprout-patients 1 [
        initialise-agent-common "patient"
        set triage-code code-value
        set triage-priority priority-value
        set triage-target-minutes triage-target-minutes-for triage-code
        set mobility-class mobility-class-for-anchor anchor-id-value
        set color red
        set size 1.35
        set label-color white
        configure-patient-mobility
      ]
    ]
  ]
end


to-report mobility-class-for-anchor [anchor-id-value]

  if case-mix-profile = "reference-UPU" [
    if member? anchor-id-value [1 2] [report "high-acuity-bed"]
    if anchor-id-value = 3 [report "low-acuity-bed"]
    if member? anchor-id-value [4 6] [report "wheelchair"]
    if member? anchor-id-value [5 7 9] [report "stamina-impaired"]
    if member? anchor-id-value [10 12] [report "ambulatory-elderly"]
    report "ambulatory-adult"
  ]

  if case-mix-profile = "lower-dependency" [
    if anchor-id-value = 1 [report "high-acuity-bed"]
    if member? anchor-id-value [2 3] [report "low-acuity-bed"]
    if anchor-id-value = 4 [report "wheelchair"]
    if member? anchor-id-value [5 6] [report "stamina-impaired"]
    if member? anchor-id-value [9 12] [report "ambulatory-elderly"]
    report "ambulatory-adult"
  ]

  ;; higher-dependency
  if member? anchor-id-value [1 2 3] [report "high-acuity-bed"]
  if member? anchor-id-value [4 6] [report "low-acuity-bed"]
  if member? anchor-id-value [5 7 9] [report "wheelchair"]
  if member? anchor-id-value [8 10 12] [report "stamina-impaired"]
  if member? anchor-id-value [11 13] [report "ambulatory-elderly"]
  report "ambulatory-adult"
end


to configure-patient-mobility  ;; patient procedure
  set assistance-need "none"
  set assistance-type "none"
  set assistants-required 0
  set clearance-width-patches 1
  set assigned-assistant-whos []
  set assigned-patient-who -1
  set agent-state "waiting-preparation"
  set preparation-required-s 0
  set preparation-elapsed-s 0
  set preparation-start-s -1
  set first-move-time-s -1
  set waiting-for-staff-s 0
  set alarm-response-s 0
  set preferred-decision-time-s preferred-assistance-max-wait-s

  if mobility-class = "high-acuity-bed" [
    set assistance-need "required"
    set assistance-type "special"
    set assistants-required 2
    set clearance-width-patches 2
    set assisted-speed-mps sample-calibrated-bed-speed
    set unassisted-speed-mps 0
    set preparation-required-s
      sample-calibrated-bed-pre-movement
    set agent-state "waiting-staff"
  ]

  if mobility-class = "low-acuity-bed" [
    set assistance-need "required"
    set assistance-type "special"
    set assistants-required 1
    set clearance-width-patches 2
    set assisted-speed-mps sample-calibrated-bed-speed
    set unassisted-speed-mps 0
    set preparation-required-s
      sample-calibrated-bed-pre-movement
    set agent-state "waiting-staff"
  ]

  if mobility-class = "wheelchair" [
    set assistance-need "required"
    set assistance-type "general"
    set assistants-required 1
    set clearance-width-patches 1
    set assisted-speed-mps sample-calibrated-wheelchair-speed
    set unassisted-speed-mps 0
    set preparation-required-s
      sample-calibrated-wheelchair-pre-movement
    set agent-state "waiting-staff"
  ]

  if mobility-class = "stamina-impaired" [
    set assistance-need "preferred"
    set assistance-type "general"
    set assistants-required 1
    set clearance-width-patches 1
    set assisted-speed-mps 0.78 * walking-speed-cal-factor
    set unassisted-speed-mps 0.57 * walking-speed-cal-factor
    set preparation-required-s
      sample-calibrated-walking-pre-movement
    set agent-state "waiting-staff"
  ]

  if mobility-class = "ambulatory-elderly" [
    set assistance-need "preferred"
    set assistance-type "general"
    set assistants-required 1
    set clearance-width-patches 1
    set elderly? true
    set assisted-speed-mps 1.05 * walking-speed-cal-factor
    set unassisted-speed-mps 0.90 * walking-speed-cal-factor
    set preparation-required-s
      sample-calibrated-walking-pre-movement
    set agent-state "waiting-staff"
  ]

  if mobility-class = "ambulatory-adult" [
    set assistance-need "none"
    set assistance-type "none"
    set assistants-required 0
    set clearance-width-patches 1
    set unassisted-speed-mps sample-calibrated-walking-speed
    set assisted-speed-mps unassisted-speed-mps
    set preparation-required-s
      sample-calibrated-walking-pre-movement
    set agent-state "preparing-self"
  ]

  apply-hazard-and-global-speed-factors
end


to create-nurse-agents
  let selected-starts sublist nurse-starts 0 n-nurses
  foreach selected-starts [xy -> create-staff-at xy "nurse"]
end


to create-doctor-agents
  let selected-starts sublist doctor-starts 0 n-doctors
  foreach selected-starts [xy -> create-staff-at xy "doctor"]
end


to create-receptionist-agents
  let selected-starts sublist receptionist-starts 0 n-receptionists
  foreach selected-starts [xy -> create-staff-at xy "receptionist"]
end


to create-staff-at [xy role-value]
  let start-patch patch (item 0 xy) (item 1 xy)
  validate-fixed-start-patch start-patch role-value xy

  ask start-patch [
    if role-value = "nurse" [
      sprout-nurses 1 [
        initialise-agent-common "nurse"
        set color pink
        set size 1.1
        configure-staff-agent
      ]
    ]
    if role-value = "doctor" [
      sprout-doctors 1 [
        initialise-agent-common "doctor"
        set color green
        set size 1.1
        configure-staff-agent
      ]
    ]
    if role-value = "receptionist" [
      sprout-receptionists 1 [
        initialise-agent-common "receptionist"
        set color brown
        set size 1.05
        configure-staff-agent
      ]
    ]
  ]
end


to configure-staff-agent  ;; turtle procedure
  set mobility-class "staff"
  set assistance-need "none"
  set assistance-type "none"
  set assistants-required 0
  set assigned-assistant-whos []
  set assigned-patient-who -1
  set clearance-width-patches 1
  set unassisted-speed-mps 1.06
  set assisted-speed-mps 1.06
  set preparation-required-s 0
  set preparation-elapsed-s 0
  set preparation-start-s -1
  set first-move-time-s -1
  set waiting-for-staff-s 0
  set alarm-response-s
    staff-response-cal-factor * sample-triangular 8 30 141
  set preferred-decision-time-s -1
  set agent-state "waiting-alarm"
  apply-hazard-and-global-speed-factors
end


to create-visitor-agents
  create-visitors-in-zone left-wing-visitors "left-hall"
  create-visitors-in-zone hallway-visitors "central-corridor"
  create-visitors-in-zone right-wing-visitors "right-hall"
end


to create-visitors-in-zone [visitor-count zone-value]
  repeat visitor-count [
    let available-patches patches with [
      walkable? and zone = zone-value and exit-id = 0 and patient-anchor-id = 0 and
      not any? turtles-here and route-to-any-exit? active-exit-id-list
    ]
    if not any? available-patches [
      error (word "Insufficient free visitor capacity in " zone-value ".")
    ]

    ask one-of available-patches [
      sprout-visitors 1 [
        initialise-agent-common "visitor"
        set mobility-class "visitor"
        set elderly? (random-float 100 < elderly-visitor-share-pct)
        set color yellow
        set size 1.0
        set clearance-width-patches 1
        set assisted-speed-mps sample-calibrated-walking-speed
        set unassisted-speed-mps assisted-speed-mps
        if elderly? [
          set assisted-speed-mps assisted-speed-mps * 0.80
          set unassisted-speed-mps unassisted-speed-mps * 0.80
        ]
        set alarm-response-s sample-triangular 8 30 63
        set agent-state "waiting-alarm"
        apply-hazard-and-global-speed-factors
      ]
    ]
  ]
end


to initialise-agent-common [role-value]  ;; turtle procedure
  set role role-value
  set shape "person"
  set triage-code ""
  set triage-priority 0
  set triage-target-minutes -1
  set mobility-class "unassigned"
  set assistance-need "none"
  set assistance-type "none"
  set assistants-required 0
  set assigned-assistant-whos []
  set assigned-patient-who -1
  set agent-state "unassigned"

  set preparation-required-s 0
  set preparation-elapsed-s 0
  set preparation-start-s -1
  set first-move-time-s -1
  set waiting-for-staff-s 0
  set alarm-response-s 0
  set preferred-decision-time-s -1
  set busy-time-s 0

  set assisted-speed-mps 0
  set unassisted-speed-mps 0
  set current-speed-mps 0
  set clearance-width-patches 1
  set movement-credit 0
  set previous-patch nobody
  set desired-patch nobody
  set move-approved? false

  set target-exit-id 0
  set last-route-cost-m large-distance
  set route-switch-count 0

  set evacuated? false
  set censored? false
  set critical-delay? false
  set evacuation-time-s -1
  set travelled-distance-m 0
  set exit-used-id 0

  set elderly? false
  set hidden? false
  set label ""
end


to apply-hazard-and-global-speed-factors  ;; turtle procedure
  if hazard-condition = "earthquake-informed" and
     member? mobility-class
       ["stamina-impaired" "ambulatory-elderly" "ambulatory-adult" "staff" "visitor"] [
    set assisted-speed-mps assisted-speed-mps * earthquake-speed-factor
    set unassisted-speed-mps unassisted-speed-mps * earthquake-speed-factor
  ]

  set assisted-speed-mps min (list maximum-speed-mps
    (assisted-speed-mps * speed-multiplier))
  set unassisted-speed-mps min (list maximum-speed-mps
    (unassisted-speed-mps * speed-multiplier))
end


to-report sample-calibrated-bed-speed
  if not empirical-variation? [report 0.67 * bed-speed-cal-factor]
  report bed-speed-cal-factor *
    sample-truncated-weibull 2.5668968424 0.7546052912 0.13 1.12
end


to-report sample-calibrated-wheelchair-speed
  if not empirical-variation? [report 1.19 * wheelchair-speed-cal-factor]
  report wheelchair-speed-cal-factor *
    sample-truncated-weibull 3.0194720903 1.3322358142 0.43 1.95
end


to-report sample-calibrated-walking-speed
  if not empirical-variation? [report 1.07 * walking-speed-cal-factor]
  report walking-speed-cal-factor *
    sample-truncated-weibull 2.3715723082 1.2072708685 0.48 1.75
end


;; Geoerg et al. (2025) mode-specific pre-movement distributions.
;; The reported empirical means and standard deviations are sampled as truncated
;; normal distributions over the documented 36--584 s support. 

to-report sample-calibrated-bed-pre-movement
  if not empirical-variation? [
    report max (list 36 (min (list 584 (194 * active-preparation-cal-factor))))
  ]
  let sampled-value sample-truncated-normal 194 115 36 584
  report max (list 36 (min (list 584 (sampled-value * active-preparation-cal-factor))))
end


to-report sample-calibrated-wheelchair-pre-movement
  if not empirical-variation? [
    report max (list 36 (min (list 584 (128 * active-preparation-cal-factor))))
  ]
  let sampled-value sample-truncated-normal 128 85 36 584
  report max (list 36 (min (list 584 (sampled-value * active-preparation-cal-factor))))
end


to-report sample-calibrated-walking-pre-movement
  if not empirical-variation? [
    report max (list 36 (min (list 584 (140 * active-preparation-cal-factor))))
  ]
  let sampled-value sample-truncated-normal 140 43 36 584
  report max (list 36 (min (list 584 (sampled-value * active-preparation-cal-factor))))
end


to-report sample-truncated-normal [mean-value sd-value lower-value upper-value]
  if sd-value <= 0 [report max (list lower-value (min (list upper-value mean-value)))]
  let sampled-value random-normal mean-value sd-value
  let attempts 1
  while [(sampled-value < lower-value or sampled-value > upper-value) and attempts < 200] [
    set sampled-value random-normal mean-value sd-value
    set attempts attempts + 1
  ]
  report max (list lower-value (min (list upper-value sampled-value)))
end


to-report sample-truncated-weibull [shape-value scale-value lower-value upper-value]
  let u random-float 1
  let sampled-value scale-value * ((- ln (max (list 0.0000001 (1 - u)))) ^ (1 / shape-value))
  let attempts 1
  while [(sampled-value < lower-value or sampled-value > upper-value) and attempts < 100] [
    set u random-float 1
    set sampled-value scale-value * ((- ln (max (list 0.0000001 (1 - u)))) ^ (1 / shape-value))
    set attempts attempts + 1
  ]
  report max (list lower-value (min (list upper-value sampled-value)))
end


to-report sample-triangular [minimum-value mode-value maximum-value]
  if not empirical-variation? [report mode-value]
  if maximum-value <= minimum-value [report minimum-value]
  if mode-value < minimum-value or mode-value > maximum-value [
    error "Triangular mode must be inside its bounds."
  ]
  let u random-float 1
  let split-point (mode-value - minimum-value) / (maximum-value - minimum-value)
  ifelse u < split-point
    [
      report minimum-value +
        sqrt (u * (maximum-value - minimum-value) * (mode-value - minimum-value))
    ]
    [
      report maximum-value -
        sqrt ((1 - u) * (maximum-value - minimum-value) * (maximum-value - mode-value))
    ]
end


to validate-fixed-start-patch [start-patch role-value xy]
  if start-patch = nobody [error (word "Invalid " role-value " start: " xy)]
  if not [walkable?] of start-patch [error (word role-value " start is not walkable: " xy)]
  if any? turtles-on start-patch [error (word role-value " start is occupied: " xy)]
  if not [route-to-any-exit? active-exit-id-list] of start-patch [
    error (word role-value " start has no route to an active exit: " xy)
  ]
end


to validate-population
  if count patients != 15 [error "Exactly 15 patient agents are required."]
  if count patients with [triage-code = "red"] != 2 [error "Expected two Red patients."]
  if count patients with [triage-code = "yellow"] != 3 [error "Expected three Yellow patients."]
  if count patients with [triage-code = "green"] != 3 [error "Expected three Green patients."]
  if count patients with [triage-code = "blue"] != 3 [error "Expected three Blue patients."]
  if count patients with [triage-code = "white"] != 4 [error "Expected four White patients."]

  if any? patients with [
    triage-priority != triage-priority-for triage-code or
    triage-target-minutes != triage-target-minutes-for triage-code
  ] [error "Triage-code metadata are inconsistent."]

  if count nurses != n-nurses [error "Nurse population audit failed."]
  if count doctors != n-doctors [error "Doctor population audit failed."]
  if count receptionists != n-receptionists [error "Receptionist population audit failed."]
  if count visitors != left-wing-visitors + hallway-visitors + right-wing-visitors [
    error "Visitor population audit failed."
  ]

  if not any? patients with [mobility-class = "high-acuity-bed"] [
    error "Every case-mix profile must include a high-acuity bed-bound patient."
  ]
  if max [assistants-required] of patients > n-nurses [
    error "The nursing team is smaller than the largest required assistance team."
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 6. DUAL CYBERNETICS FEEDBACK: RESOURCES AND ROUTES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to go
  if run-complete? [stop]

  set current-time-s ticks * seconds-per-tick
  update-critical-delay-status
  update-agent-state-transitions
  update-resource-waiting-times
  allocate-nursing-resources-if-due
  update-preparation-processes
  update-route-choices false


  register-evacuations
  if all? turtles [evacuated? or censored?] [
    finish-run "all-agents-resolved"
    stop
  ]

  prepare-movement-intentions
  resolve-movement-conflicts
  execute-approved-movements

  set current-time-s (ticks + 1) * seconds-per-tick
  update-nurse-arrival-states
  register-evacuations
  accumulate-nurse-utilisation

  tick
  set current-time-s ticks * seconds-per-tick
  update-critical-delay-status
  update-agent-labels

  if all? turtles [evacuated? or censored?] [
    finish-run "all-agents-resolved"
    stop
  ]

  if current-time-s >= simulation-horizon-s [
    ask turtles with [not evacuated? and not censored?] [
      set censored? true
      set critical-delay? true
      set desired-patch nobody
    ]
    finish-run "simulation-horizon-reached"
    stop
  ]
end


to update-agent-state-transitions
  ;; Non-nursing occupants begin self-evacuation after their response delay.
  ask doctors with [agent-state = "waiting-alarm" and current-time-s >= alarm-response-s] [
    set agent-state "self-evacuating"
  ]
  ask receptionists with [agent-state = "waiting-alarm" and current-time-s >= alarm-response-s] [
    set agent-state "self-evacuating"
  ]
  ask visitors with [agent-state = "waiting-alarm" and current-time-s >= alarm-response-s] [
    set agent-state "self-evacuating"
  ]

  ask nurses with [agent-state = "waiting-alarm" and current-time-s >= alarm-response-s] [
    set agent-state "available"
  ]

  
ask patients with [
  assistance-need = "preferred" and
  agent-state = "waiting-staff" and
  current-time-s >= preferred-decision-time-s and
  not full-assistance-team-at-patient?
] [
  release-assigned-nurses-in-place
  set agent-state "preparing-self"
]


  let unmet-assistance-demand? any? patients with [
    not evacuated? and not censored? and
    agent-state = "waiting-staff" and assistance-need != "none" and
    length assigned-assistant-whos < assistants-required
  ]

  if not unmet-assistance-demand? [
    ask nurses with [agent-state = "available"] [
      set agent-state "self-evacuating"
    ]
  ]
end

to audit-resource-priority-ordering [queue-agentset]

  ;; This audit concerns the cybernetics-priority rule only.
  if resource-allocation-rule != "cybernetic-priority" [
    stop
  ]

  ;; At least two patients are required for an ordering comparison.
  if count queue-agentset < 2 [
    stop
  ]

  ;; The ordering must be operationally actionable: at least one nurse
  ;; must currently be available for dispatch.
  let available-pool nurses with [
    agent-state = "available" and
    assigned-patient-who = -1 and
    not evacuated? and
    not censored?
  ]

  if not any? available-pool [
    stop
  ]

  set resource-priority-audit-opportunities-count
    resource-priority-audit-opportunities-count + 1

  let static-order sort-by
    [[a b] -> patient-higher-static-resource-priority? a b]
    queue-agentset

  let cybernetic-order sort-by
    [[a b] -> patient-higher-cybernetic-resource-priority? a b]
    queue-agentset

  let static-whos
    map [patient-agent -> [who] of patient-agent] static-order

  let cybernetic-whos
    map [patient-agent -> [who] of patient-agent] cybernetic-order

  ;; Counter 1: the complete patient ordering differs.
  if static-whos != cybernetic-whos [
    set resource-priority-order-differences-count
      resource-priority-order-differences-count + 1
  ]

  ;; Counter 2: the patient selected first differs.
  if first static-whos != first cybernetic-whos [
    set resource-priority-top-choice-differences-count
      resource-priority-top-choice-differences-count + 1
  ]
end

to allocate-nursing-resources-if-due

  let review-ticks max
    (list 1
      (round (resource-review-interval-s / seconds-per-tick)))

  if ticks mod review-ticks != 0 [stop]

  ;; Closed-loop corrective action before new dispatch.
  if resource-feedback? [
    rebalance-nursing-resources
  ]

  let queue (patients with [
    not evacuated? and
    not censored? and
    agent-state = "waiting-staff" and
    assistance-need != "none" and
    length assigned-assistant-whos < assistants-required
  ])
  
  ;; Positive-control audit:
;; compare the static and cybernetics queue orderings under the same state.
  audit-resource-priority-ordering queue

  let ordered-patients sort-by
    [[a b] -> patient-higher-resource-priority? a b]
    queue

  foreach ordered-patients [dependent ->
    ask dependent [
      assign-available-nurses
    ]
  ]
end


to-report patient-higher-resource-priority? [patient-a patient-b]

  ;; Comparator used by the actual allocation and reallocation procedures.
  ;; It delegates to resource-priority-score, so the selected ordering follows
  ;; the active feedback state and the selected allocation rule.
  let score-a [resource-priority-score] of patient-a
  let score-b [resource-priority-score] of patient-b

  if score-a != score-b [
    report score-a > score-b
  ]

  ;; Deterministic tie-break for reproducibility.
  report [who] of patient-a < [who] of patient-b
end


to-report patient-higher-static-resource-priority? [patient-a patient-b]

  let score-a [static-resource-priority-score] of patient-a
  let score-b [static-resource-priority-score] of patient-b

  if score-a != score-b [
    report score-a > score-b
  ]

  ;; Deterministic tie-break.
  report [who] of patient-a < [who] of patient-b
end


to-report patient-higher-cybernetic-resource-priority? [patient-a patient-b]

  let score-a [cybernetic-resource-priority-score] of patient-a
  let score-b [cybernetic-resource-priority-score] of patient-b

  if score-a != score-b [
    report score-a > score-b
  ]

  ;; Deterministic tie-break.
  report [who] of patient-a < [who] of patient-b
end

to-report static-resource-priority-score  ;; patient reporter
  report 6 - triage-priority
end


to-report cybernetic-resource-priority-score  ;; patient reporter
  let wait-minutes waiting-for-staff-s / 60

  report
    triage-priority-weight * (6 - triage-priority) +
    waiting-time-weight * wait-minutes +
    dependency-weight * assistants-required
end

to-report resource-priority-score  ;; patient reporter

  let wait-minutes waiting-for-staff-s / 60

  ;; Feedback OFF is the static clinical-triage comparator.
  if not resource-feedback? [
    report static-resource-priority-score
  ]

  if resource-allocation-rule = "triage-only" [
    report static-resource-priority-score
  ]

  if resource-allocation-rule = "FIFO" [
    report wait-minutes
  ]

  ;; Feedback ON uses the dynamic cybernetics-priority score.
  report cybernetic-resource-priority-score
end

to-report resource-priority-order-difference-rate-pct

  if resource-priority-audit-opportunities-count = 0 [
    report 0
  ]

  report
    100 * resource-priority-order-differences-count /
    resource-priority-audit-opportunities-count
end


to-report resource-priority-top-choice-difference-rate-pct

  if resource-priority-audit-opportunities-count = 0 [
    report 0
  ]

  report
    100 * resource-priority-top-choice-differences-count /
    resource-priority-audit-opportunities-count
end

to-report resource-priority-positive-control-pass?

  ;; Two hypothetical patients have the same triage rank.
  ;; Under the static rule they are tied.
  let triage-rank-a 3
  let triage-rank-b 3

  let wait-a-s 0
  let wait-b-s 180

  let team-a 1
  let team-b 2

  let static-a 6 - triage-rank-a
  let static-b 6 - triage-rank-b

  let cybernetic-a
    triage-priority-weight * (6 - triage-rank-a) +
    waiting-time-weight * (wait-a-s / 60) +
    dependency-weight * team-a

  let cybernetic-b
    triage-priority-weight * (6 - triage-rank-b) +
    waiting-time-weight * (wait-b-s / 60) +
    dependency-weight * team-b

  report
    static-a = static-b and
    cybernetic-b > cybernetic-a
end

to assign-available-nurses  ;; patient procedure
  let needed assistants-required - length assigned-assistant-whos
  if needed <= 0 [stop]

  let anchor-id-value [patient-anchor-id] of patch-here
  if anchor-id-value <= 0 [stop]


  let candidate-set (nurses with [
    agent-state = "available" and
    assigned-patient-who = -1 and
    not evacuated? and
    not censored? and
    [distance-to-anchor-patches anchor-id-value] of patch-here < large-distance
  ])

  let candidates sort-by
    [[a b] -> nurse-closer-to-anchor? a b anchor-id-value]
    candidate-set

  let number-to-assign min (list needed length candidates)
  if number-to-assign <= 0 [stop]

  foreach sublist candidates 0 number-to-assign [helper ->
    let dependent-who who
    let helper-who [who] of helper

    set assigned-assistant-whos lput helper-who assigned-assistant-whos

    create-assistance-link-with helper [
      set color pink
      set thickness 0.12
      set hidden? false
    ]

    if [[exit-id] of patch-here] of helper > 0 [
      set nurse-return-trips nurse-return-trips + 1
    ]

    ask helper [
      set assigned-patient-who dependent-who
      set agent-state "dispatched"
      set target-exit-id 0
      set last-route-cost-m large-distance
      set desired-patch nobody
      set move-approved? false
    ]

    set resource-assignments-count resource-assignments-count + 1
  ]
end


to-report nurse-closer-to-anchor? [nurse-a nurse-b anchor-id-value]
  let patch-a [patch-here] of nurse-a
  let patch-b [patch-here] of nurse-b
  let distance-a [distance-to-anchor-patches anchor-id-value] of patch-a
  let distance-b [distance-to-anchor-patches anchor-id-value] of patch-b
  if distance-a != distance-b [report distance-a < distance-b]
  report [who] of nurse-a < [who] of nurse-b
end


to update-preparation-processes
  ;; Patients without required staff prepare independently.
  ask patients with [agent-state = "preparing-self"] [
    if preparation-start-s < 0 [set preparation-start-s current-time-s]
    set preparation-elapsed-s preparation-elapsed-s + seconds-per-tick
    if preparation-elapsed-s >= preparation-required-s [
      set agent-state "self-evacuating"
    ]
  ]

 
  ask patients with [
    agent-state = "waiting-staff" or agent-state = "preparing-assisted"
  ] [
    if full-assistance-team-at-patient? [
      if preparation-start-s < 0 [
        set preparation-start-s current-time-s
      ]
      set agent-state "preparing-assisted"
      ask assigned-nurse-agentset [set agent-state "preparing"]
      set preparation-elapsed-s preparation-elapsed-s + seconds-per-tick

      if preparation-elapsed-s >= preparation-required-s [
        set agent-state "evacuating"
        ask assigned-nurse-agentset [set agent-state "escorting"]
      ]
    ]
  ]
end


to-report assigned-nurse-agentset  ;; patient reporter
  let result no-turtles
  foreach assigned-assistant-whos [helper-id ->
    let helper turtle helper-id
    if helper != nobody [set result (turtle-set result helper)]
  ]
  report result
end


to-report assistance-team-radius-patches
  report assistance-team-radius-m / meters-per-patch
end



to-report assistance-arrival-radius-patches-for [dependent]
  if dependent = nobody [report assistance-team-radius-patches]
  report assistance-team-radius-patches
end



to-report path-distance-to-assigned-patient-anchor  ;; nurse reporter
  if assigned-patient-who < 0 [report large-distance]
  let dependent turtle assigned-patient-who
  if dependent = nobody [report large-distance]
  if [evacuated? or censored?] of dependent [report large-distance]

  let dependent-patch [patch-here] of dependent
  let anchor-id-value [patient-anchor-id] of dependent-patch
  if anchor-id-value <= 0 [report large-distance]

  report [distance-to-anchor-patches anchor-id-value] of patch-here
end


to-report full-assistance-team-at-patient?  ;; patient reporter
  if assistants-required = 0 [report true]
  if length assigned-assistant-whos < assistants-required [report false]

  let anchor-id-value [patient-anchor-id] of patch-here
  if anchor-id-value <= 0 [report false]
  let allowed-radius assistance-arrival-radius-patches-for self

  let valid? true
  foreach assigned-assistant-whos [helper-id ->
    let helper turtle helper-id
    if helper = nobody [set valid? false]
    if helper != nobody [
      if [evacuated? or censored?] of helper [set valid? false]
      let helper-patch [patch-here] of helper
      if [distance-to-anchor-patches anchor-id-value] of helper-patch > allowed-radius [
        set valid? false
      ]
    ]
  ]
  report valid?
end


to update-nurse-arrival-states
  ask nurses with [
    agent-state = "dispatched" and
    assigned-patient-who >= 0
  ] [

    let dependent turtle assigned-patient-who

    ifelse dependent = nobody or [evacuated? or censored?] of dependent
    [
      set assigned-patient-who -1
      set agent-state "available"
      ask my-assistance-links [die]
    ]
    [
      let route-distance path-distance-to-assigned-patient-anchor

    
      ifelse route-distance >= large-distance
      [
        let helper-who who

        ask dependent [
          set assigned-assistant-whos
            remove helper-who assigned-assistant-whos
        ]

        ask my-assistance-links [die]

        set assigned-patient-who -1
        set agent-state "available"
        set desired-patch nobody
        set move-approved? false
      ]
      [
        let allowed-radius assistance-arrival-radius-patches-for dependent

        if route-distance <= allowed-radius [
          set agent-state "at-patient"
        ]
      ]
    ]
  ]
end


to prepare-movement-intentions
  ask turtles [
    set desired-patch nobody
    set move-approved? false
  ]

  foreach sort (turtles with [movement-leader?]) [agent ->
    ask agent [
      set current-speed-mps effective-current-speed-mps
      set movement-credit min (list 1.99
        (movement-credit + current-speed-mps * seconds-per-tick / meters-per-patch))

      if movement-credit >= 1 [
        if role = "nurse" and agent-state = "dispatched" [
          let dependent turtle assigned-patient-who
          if dependent != nobody [
            let dependent-patch [patch-here] of dependent
            let target-anchor-id [patient-anchor-id] of dependent-patch
            let allowed-radius assistance-arrival-radius-patches-for dependent
            if target-anchor-id > 0 and
               path-distance-to-assigned-patient-anchor > allowed-radius [
              let candidates next-step-candidates-to-anchor target-anchor-id
              if any? candidates [
                set desired-patch choose-best-anchor-step candidates
              ]
            ]
          ]
        ]

        if desired-patch = nobody and needs-exit-route? [
          let candidates next-step-candidates-to-exit
          if any? candidates [
            set desired-patch choose-best-exit-step candidates target-exit-id
          ]
        ]
      ]
    ]
  ]
end



to-report movement-leader?  ;; turtle reporter
  if evacuated? or censored? [report false]


  if [exit-id] of patch-here > 0 [
    if role = "nurse" and agent-state = "dispatched" [report true]
    report false
  ]

  if role = "patient" [
    report member? agent-state ["self-evacuating" "evacuating"]
  ]
  if role = "nurse" [
    report member? agent-state ["dispatched" "self-evacuating"]
  ]
  report agent-state = "self-evacuating"
end


to-report effective-current-speed-mps  ;; turtle reporter
  if role = "patient" [
    if agent-state = "evacuating" [report assisted-speed-mps]
    report unassisted-speed-mps
  ]
  report unassisted-speed-mps
end



to-report assistance-step-destination-clear? [dependent-who-value]  ;; patch reporter
  let blockers turtles-here with [
    occupies-physical-space? and
    not (
      role = "nurse" and
      assigned-patient-who = dependent-who-value and
      member? agent-state ["at-patient" "preparing"]
    )
  ]
  report not any? blockers
end


to-report assigned-patient-triage-priority  ;; nurse reporter
  if role != "nurse" or assigned-patient-who < 0 [report 99]
  let dependent turtle assigned-patient-who
  if dependent = nobody [report 99]
  report [triage-priority] of dependent
end



to-report next-step-candidates-to-anchor [anchor-id-value]  ;; turtle reporter
  let current-distance [distance-to-anchor-patches anchor-id-value] of patch-here
  let dependent-who-value assigned-patient-who
  let previous-location previous-patch


  let improving neighbors4 with [
    walkable? and
    distance-to-anchor-patches anchor-id-value < current-distance and
    assistance-step-destination-clear? dependent-who-value
  ]
  if any? improving [report improving]

  let blocked-improving neighbors4 with [
    walkable? and
    distance-to-anchor-patches anchor-id-value < current-distance
  ]
  let blocking-nurses (turtles-on blocked-improving) with [
    role = "nurse" and
    agent-state = "dispatched" and
    assigned-patient-who >= 0 and
    assigned-patient-who != dependent-who-value
  ]

  if not any? blocking-nurses [report no-patches]

  let my-priority assigned-patient-triage-priority
  let blocker min-one-of blocking-nurses [assigned-patient-triage-priority]
  let blocker-priority [assigned-patient-triage-priority] of blocker

  let should-yield? false
  if my-priority > blocker-priority [set should-yield? true]
  if my-priority = blocker-priority and who > [who] of blocker [
    set should-yield? true
  ]
  if not should-yield? [report no-patches]


  let detours neighbors4 with [
    walkable? and
    distance-to-anchor-patches anchor-id-value < large-distance and
    distance-to-anchor-patches anchor-id-value <= current-distance + 1 and
    self != previous-location and
    assistance-step-destination-clear? dependent-who-value
  ]
  if any? detours [report detours]


  if previous-location != nobody [
    let previous-walkable? [walkable?] of previous-location
    let previous-distance [distance-to-anchor-patches anchor-id-value] of previous-location
    let previous-clear? [assistance-step-destination-clear? dependent-who-value] of previous-location
    if previous-walkable? and previous-distance < large-distance and previous-clear? [
      report patch-set previous-location
    ]
  ]

  report no-patches
end


to-report choose-best-anchor-step [candidate-set]  ;; turtle reporter
  let dependent turtle assigned-patient-who
  if dependent = nobody [report nobody]
  let anchor-id-value [[patient-anchor-id] of patch-here] of dependent
  let ordered sort candidate-set
  let best-patch first ordered
  let best-cost [distance-to-anchor-patches anchor-id-value] of best-patch
  foreach but-first ordered [candidate ->
    let candidate-cost [distance-to-anchor-patches anchor-id-value] of candidate
    if candidate-cost < best-cost [
      set best-patch candidate
      set best-cost candidate-cost
    ]
  ]
  report best-patch
end


to-report next-step-candidates-to-exit  ;; turtle reporter
  let target-id target-exit-id
  if target-id = 0 [report no-patches]

  let required-width clearance-width-patches

  report neighbors4 with [
    walkable? and
    distance-to-exit-patches-for-width target-id required-width < large-distance and
    destination-clear-for-agent? myself and
    not any? turtles-here with [occupies-physical-space?]
  ]
end


to-report destination-clear-for-agent? [agent-value]  ;; patch reporter
  let required-width [clearance-width-patches] of agent-value
  if required-width <= 1 [report true]

  if exit-id > 0 [
    report count patches with [exit-id = [exit-id] of myself and walkable?] >= required-width
  ]

  let origin [patch-here] of agent-value
  let delta-x pxcor - [pxcor] of origin
  let delta-y pycor - [pycor] of origin

  if delta-x != 0 [
    let north patch-at 0 1
    let south patch-at 0 -1
    report ((north != nobody and [walkable?] of north and
             not any? ((turtles-on north) with [occupies-physical-space?])) or
            (south != nobody and [walkable?] of south and
             not any? ((turtles-on south) with [occupies-physical-space?])))
  ]

  if delta-y != 0 [
    let east patch-at 1 0
    let west patch-at -1 0
    report ((east != nobody and [walkable?] of east and
             not any? ((turtles-on east) with [occupies-physical-space?])) or
            (west != nobody and [walkable?] of west and
             not any? ((turtles-on west) with [occupies-physical-space?])))
  ]

  report true
end


to-report choose-best-exit-step [candidate-set target-id]  ;; turtle reporter
  let ordered sort candidate-set
  if empty? ordered [report nobody]

  let previous-location previous-patch
  let required-width clearance-width-patches
  let best-patch first ordered
  let best-cost
    [movement-cost-m target-id previous-location required-width] of best-patch

  foreach but-first ordered [candidate ->
    let candidate-cost
      [movement-cost-m target-id previous-location required-width] of candidate
    if candidate-cost < best-cost [
      set best-patch candidate
      set best-cost candidate-cost
    ]
  ]
  report best-patch
end


to-report movement-cost-m [target-id previous-location required-width]  ;; patch reporter
  let remaining-distance
    distance-to-exit-m-for-width target-id required-width
  if remaining-distance >= large-distance [report large-distance]

  let local-crowd count turtles in-radius 1 with [
    not evacuated? and not censored? and occupies-physical-space?
  ]

  let backtrack-cost 0
  if previous-location != nobody and self = previous-location [
    set backtrack-cost backtracking-penalty-m
  ]

  report remaining-distance +
         local-congestion-penalty-m * local-crowd + backtrack-cost
end


to resolve-movement-conflicts
  let movers (turtles with [desired-patch != nobody])
  let destinations remove-duplicates [desired-patch] of movers

  foreach destinations [destination ->
    let contenders (movers with [desired-patch = destination])
    if any? contenders [
      ask deterministic-movement-winner contenders [set move-approved? true]
    ]
  ]
end


to-report deterministic-movement-winner [candidate-set]
  let ordered sort candidate-set
  let winner first ordered
  let best-priority [movement-priority] of winner
  foreach but-first ordered [agent ->
    let candidate-priority [movement-priority] of agent
    if candidate-priority < best-priority [
      set winner agent
      set best-priority candidate-priority
    ]
  ]
  report winner
end


to-report movement-priority  ;; turtle reporter; lower value moves first
  if role = "patient" and assistance-need = "required" [report triage-priority]
  if role = "patient" and assistance-need = "preferred" [report 10 + triage-priority]
  if role = "patient" [report 20 + triage-priority]
  if role = "nurse" and agent-state = "dispatched" [report 30]
  if role = "nurse" [report 40]
  if role = "doctor" [report 41]
  if role = "receptionist" [report 42]
  report 50
end


to execute-approved-movements
  foreach sort (turtles with [move-approved?]) [agent ->
    ask agent [
      let origin patch-here
      let destination desired-patch
      move-to destination
      set previous-patch origin
      set travelled-distance-m travelled-distance-m + meters-per-patch
      set movement-credit movement-credit - 1
      if first-move-time-s < 0 [set first-move-time-s current-time-s]

      if role = "patient" and agent-state = "evacuating" [
        ask assigned-nurse-agentset [
          move-to destination
          set travelled-distance-m travelled-distance-m + meters-per-patch
          set target-exit-id [target-exit-id] of myself
          set last-route-cost-m [last-route-cost-m] of myself
        ]
      ]
    ]
  ]
end


to register-evacuations

  foreach sort (patients with [
    not evacuated? and not censored? and [exit-id] of patch-here > 0
  ]) [dependent ->
    ask dependent [complete-patient-evacuation]
  ]

  foreach sort (turtles with [
    role != "patient" and not evacuated? and not censored? and
    [exit-id] of patch-here > 0 and
    not (role = "nurse" and agent-state != "self-evacuating")
  ]) [agent ->
    ask agent [complete-independent-evacuation]
  ]
end


to complete-patient-evacuation  ;; patient procedure
  set evacuated? true
  set agent-state "evacuated"
  set evacuation-time-s current-time-s
  set exit-used-id [exit-id] of patch-here
  set desired-patch nobody
  if evacuation-time-s >= critical-delay-threshold-s [set critical-delay? true]

  release-assigned-nurses-after-evacuation
  set hidden? true
  set label ""
end


to complete-independent-evacuation  ;; turtle procedure
  set evacuated? true
  set agent-state "evacuated"
  set evacuation-time-s current-time-s
  set exit-used-id [exit-id] of patch-here
  set desired-patch nobody
  if evacuation-time-s >= critical-delay-threshold-s [set critical-delay? true]
  set hidden? true
  set label ""
end


to release-assigned-nurses-in-place  ;; patient procedure

  foreach assigned-assistant-whos [helper-id ->
    let helper turtle helper-id
    if helper != nobody and not [evacuated? or censored?] of helper [
      ask helper [
        set assigned-patient-who -1
        set agent-state "available"
      ]
    ]
  ]
  ask my-assistance-links [die]
  set assigned-assistant-whos []
end


to release-assigned-nurses-after-evacuation  ;; patient procedure

  foreach assigned-assistant-whos [helper-id ->
    let helper turtle helper-id
    if helper != nobody and not [evacuated? or censored?] of helper [
      ask helper [
        set assigned-patient-who -1
        set agent-state "available"
        set target-exit-id 0
        set last-route-cost-m large-distance
        set desired-patch nobody
        set move-approved? false
        set previous-patch nobody
      ]
    ]
  ]
  ask my-assistance-links [die]
  set assigned-assistant-whos []
end

to accumulate-nurse-utilisation
  ask nurses with [member? agent-state ["dispatched" "at-patient" "preparing" "escorting"]] [
    set busy-time-s busy-time-s + seconds-per-tick
  ]
  set total-nurse-busy-time-s sum [busy-time-s] of nurses
end


to-report occupies-physical-space?  ;; turtle reporter
  if evacuated? or censored? [report false]

  
  if role = "nurse" and agent-state = "escorting" [report false]


  if role = "nurse" and [exit-id] of patch-here > 0 and
     member? agent-state ["available" "self-evacuating" "dispatched"] [
    report false
  ]

  report true
end


to update-critical-delay-status
  if current-time-s >= critical-delay-threshold-s [
    ask turtles with [not evacuated? and not censored?] [set critical-delay? true]
  ]
end


to finish-run [reason-value]
  set run-complete? true
  set run-stop-reason reason-value
  set current-time-s ticks * seconds-per-tick
  verify-model-state
end


to update-agent-labels
  ask turtles with [not hidden?] [
    ifelse show-agent-labels? and role = "patient"
      [set label (word triage-code-label triage-code "/" mobility-short-label mobility-class)]
      [set label ""]
  ]
end


to-report mobility-short-label [class-value]
  if class-value = "high-acuity-bed" [report "HB"]
  if class-value = "low-acuity-bed" [report "LB"]
  if class-value = "wheelchair" [report "WC"]
  if class-value = "stamina-impaired" [report "SI"]
  if class-value = "ambulatory-elderly" [report "AE"]
  if class-value = "ambulatory-adult" [report "AA"]
  report ""
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 7. VERIFICATION, CALIBRATION, VALIDATION AND OUTPUT REPORTERS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


to-report unresolved-agent-summary
  report [
    (list who role agent-state triage-code mobility-class xcor ycor
      target-exit-id assistants-required assigned-assistant-whos
      assigned-patient-who preparation-elapsed-s preparation-required-s
      movement-credit)
  ] of turtles with [not evacuated? and not censored?]
end


to-report censored-agent-summary
  report [
    (list who role agent-state triage-code mobility-class xcor ycor
      target-exit-id assistants-required assigned-assistant-whos
      assigned-patient-who preparation-elapsed-s preparation-required-s
      movement-credit)
  ] of turtles with [censored?]
end


to run-built-in-self-test

  set-default-parameters
  set scenario-preset "BASE"
  load-scenario-preset
  set empirical-variation? false
  set case-mix-profile "reference-UPU"
  set n-nurses 16
  set obstacle-density-pct 0
  set time-step-s 0.25
  set simulation-horizon-s 1800
  setup

  while [not run-complete?] [go]

  if completion-rate-pct != 100 [
    set verification-status (word "self-test failed; censored=" censored-agent-summary)
    error verification-status
  ]
  if censored-count != 0 [error "Self-test failed: censored agents in BASE."]
  if count patients != 15 [error "Self-test failed: patient count."]
  if active-exit-count != 2 [error "Self-test failed: BASE exit count."]
  if exit-use-count 3 != 0 or exit-use-count 4 != 0 [
    error "Self-test failed: proposed exits used in BASE."
  ]
  if evacuated-count != initial-population [
    error "Self-test failed: population accounting."
  ]
  set verification-status "built-in self-test passed"
end


to verify-model-state
  if count turtles != initial-population and initial-population > 0 [
    error "Population conservation failed."
  ]

  if evacuated-count + remaining-count + censored-count != initial-population and
     initial-population > 0 [
    error "Resolved/unresolved accounting identity failed."
  ]

  if any? nurses with [
    assigned-patient-who >= 0 and (turtle assigned-patient-who) = nobody
  ] [
    error "A nurse references a missing patient."
  ]

  if any? patients with [
    length assigned-assistant-whos != length remove-duplicates assigned-assistant-whos
  ] [
    error "A patient has a duplicated assistant assignment."
  ]

  if maximum-speed-mps * seconds-per-tick > meters-per-patch [
    error "Time-step stability condition failed."
  ]

  if not resource-feedback? and resource-reallocations-count > 0 [
    error "Resource reallocation occurred while resource feedback was OFF."
  ]

  if resource-reallocation-distance-saved-m < 0 [
    error "Resource reallocation distance saving cannot be negative."
  ]

  if any? nurses with [
    assigned-patient-who >= 0 and
    not member? who [assigned-assistant-whos] of (turtle assigned-patient-who)
  ] [
    error "Bidirectional nurse-patient assignment consistency failed."
  ]
if resource-priority-order-differences-count >
   resource-priority-audit-opportunities-count [
  error "Resource-priority order-difference count exceeds audit opportunities."
]

if resource-priority-top-choice-differences-count >
   resource-priority-order-differences-count [
  error "Top-choice differences exceed complete-order differences."
]
  set verification-status "passed"
end


to-report resolved-article-scenario
  if hazard-condition = "no-hazard" and existing-door-opening = "fully-open" and
     not additional-exits? and obstacle-density-pct = 0 [report "BASE"]
  if hazard-condition = "fire-informed" and existing-door-opening = "fully-open" [
    ifelse additional-exits? [report "S.3.a"] [report "S.1.a"]
  ]
  if hazard-condition = "earthquake-informed" and existing-door-opening = "fully-open" [
    ifelse additional-exits? [report "S.3.b"] [report "S.1.b"]
  ]
  if hazard-condition = "fire-informed" and existing-door-opening = "partially-open" [
    ifelse additional-exits? [report "S.4.a"] [report "S.2.a"]
  ]
  if hazard-condition = "earthquake-informed" and existing-door-opening = "partially-open" [
    ifelse additional-exits? [report "S.4.b"] [report "S.2.b"]
  ]
  report "CUSTOM"
end


to-report scenario-id
  report word resolved-article-scenario
    (word "|obs=" obstacle-density-pct "|seed=" experiment-seed
          "|mix=" case-mix-profile "|routeFB=" adaptive-routing?
          "|resourceFB=" resource-feedback?)
end


to-report scenario-description
  report scenario-description-text
end


to-report preset-status
  ifelse scenario-preset = resolved-article-scenario
    [report "preset matches controls"]
    [report "controls modified / custom"]
end


to-report intervention-label
  ifelse additional-exits? [report "two proposed exits active"] [report "existing exits only"]
end


to-report comparison-pair-id
  report word
    (ifelse-value member? resolved-article-scenario ["S.1.a" "S.3.a"] ["PAIR-1a-3a"]
      [ifelse-value member? resolved-article-scenario ["S.1.b" "S.3.b"] ["PAIR-1b-3b"]
        [ifelse-value member? resolved-article-scenario ["S.2.a" "S.4.a"] ["PAIR-2a-4a"]
          [ifelse-value member? resolved-article-scenario ["S.2.b" "S.4.b"] ["PAIR-2b-4b"]
            [resolved-article-scenario]]]])
    (word "|obs=" obstacle-density-pct "|seed=" experiment-seed "|mix=" case-mix-profile)
end


to-report elapsed-time-s
  report current-time-s
end


to-report remaining-count
  report count turtles with [not evacuated? and not censored?]
end


to-report evacuated-count
  report count turtles with [evacuated?]
end


to-report censored-count
  report count turtles with [censored?]
end


to-report completion-rate-pct
  if initial-population = 0 [report 0]
  report 100 * evacuated-count / initial-population
end


to-report critical-delay-count
  report count turtles with [critical-delay?]
end


to-report critical-delay-rate-pct
  if initial-population = 0 [report 0]
  report 100 * critical-delay-count / initial-population
end


to-report complete-evacuation-time-s
  if censored-count > 0 [report -1]
  if not any? turtles with [evacuated?] [report -1]
  report max [evacuation-time-s] of turtles with [evacuated?]
end


to-report mean-evacuation-time-s
  let completed turtles with [evacuated?]
  if not any? completed [report -1]
  report mean [evacuation-time-s] of completed
end


to-report median-evacuation-time-s
  let completed sort [evacuation-time-s] of turtles with [evacuated?]
  if empty? completed [report -1]
  report median completed
end


to-report p95-evacuation-time-s
  let values sort [evacuation-time-s] of turtles with [evacuated?]
  if empty? values [report -1]
  report list-percentile values 95
end


to-report restricted-mean-time-s
  if initial-population = 0 [report -1]
  report mean [
    ifelse-value evacuated? [evacuation-time-s]
      [ifelse-value censored? [simulation-horizon-s] [current-time-s]]
  ] of turtles
end


to-report list-percentile [sorted-values percentile-value]
  if empty? sorted-values [report -1]
  let n length sorted-values
  let percentile-position (percentile-value / 100) * (n - 1)
  let lower-index floor percentile-position
  let upper-index ceiling percentile-position
  if lower-index = upper-index [report item lower-index sorted-values]
  let fraction percentile-position - lower-index
  report item lower-index sorted-values +
    fraction * (item upper-index sorted-values - item lower-index sorted-values)
end


to-report role-count [role-value]
  report count turtles with [role = role-value]
end

to-report role-critical-delay-rate-pct [role-value]
  let group turtles with [role = role-value]
  if not any? group [report 0]
  report 100 * count group with [critical-delay?] / count group
end

to-report role-mean-evacuation-time-s [role-value]
  let group turtles with [role = role-value and evacuated?]
  if not any? group [report -1]
  report mean [evacuation-time-s] of group
end


to-report triage-patient-count [code-value]
  report count patients with [triage-code = code-value]
end

to-report triage-critical-delay-rate-pct [code-value]
  let group patients with [triage-code = code-value]
  if not any? group [report 0]
  report 100 * count group with [critical-delay?] / count group
end

to-report triage-mean-evacuation-time-s [code-value]
  let group patients with [triage-code = code-value and evacuated?]
  if not any? group [report -1]
  report mean [evacuation-time-s] of group
end


to-report triage-completion-rate-pct [code-value]
  let group patients with [triage-code = code-value]
  if not any? group [report 0]
  report 100 * count group with [evacuated?] / count group
end


to-report triage-censored-rate-pct [code-value]
  let group patients with [triage-code = code-value]
  if not any? group [report 0]
  report 100 * count group with [censored?] / count group
end


to-report triage-restricted-mean-time-s [code-value]
  let group patients with [triage-code = code-value]
  if not any? group [report -1]
  report mean [
    ifelse-value evacuated? [evacuation-time-s]
      [ifelse-value censored? [simulation-horizon-s] [current-time-s]]
  ] of group
end


to-report mobility-count [class-value]
  report count patients with [mobility-class = class-value]
end

to-report mobility-critical-delay-rate-pct [class-value]
  let group patients with [mobility-class = class-value]
  if not any? group [report 0]
  report 100 * count group with [critical-delay?] / count group
end

to-report mobility-mean-evacuation-time-s [class-value]
  let group patients with [mobility-class = class-value and evacuated?]
  if not any? group [report -1]
  report mean [evacuation-time-s] of group
end

to-report mobility-mean-pre-movement-s [class-value]
  let group patients with [mobility-class = class-value and first-move-time-s >= 0]
  if not any? group [report -1]
  report mean [first-move-time-s] of group
end

to-report mobility-mean-free-speed-mps [class-value]
  let group patients with [mobility-class = class-value]
  if not any? group [report -1]
  report mean [ifelse-value (assistance-need = "required")
    [assisted-speed-mps] [unassisted-speed-mps]] of group
end


to-report mean-patient-staff-wait-s
  let group patients with [preparation-start-s >= 0 and assistance-need != "none"]
  if not any? group [report 0]
  report mean [waiting-for-staff-s] of group
end


to-report max-patient-staff-wait-s
  let group patients with [preparation-start-s >= 0 and assistance-need != "none"]
  if not any? group [report 0]
  report max [waiting-for-staff-s] of group
end


to-report nurse-utilisation-pct
  if n-nurses = 0 or current-time-s <= 0 [report 0]
  report 100 * total-nurse-busy-time-s / (n-nurses * current-time-s)
end


to-report total-route-switches
  report sum [route-switch-count] of turtles
end


to-report exit-use-count [id-value]
  report count turtles with [evacuated? and exit-used-id = id-value]
end


to-report active-exit-count
  report length active-exit-id-list
end


to-report exit-width-m [id-value]
  report meters-per-patch * count patches with [exit-id = id-value and walkable?]
end


to-report triage-weighted-mean-time-s
  let completed patients with [evacuated?]
  if not any? completed [report -1]
  let numerator sum [(6 - triage-priority) * evacuation-time-s] of completed
  let denominator sum [(6 - triage-priority)] of completed
  if denominator = 0 [report -1]
  report numerator / denominator
end


to-report triage-equity-gap-s
  let means []
  foreach ["red" "yellow" "green" "blue" "white"] [code-value ->
    let value triage-mean-evacuation-time-s code-value
    if value >= 0 [set means lput value means]
  ]
  if length means < 2 [report 0]
  report max means - min means
end


to-report geoerg-speed-calibration-loss
  let loss 0
  let components 0

  let bed-group patients with [member? mobility-class ["high-acuity-bed" "low-acuity-bed"]]
  if any? bed-group [
    let sim mean [assisted-speed-mps] of bed-group
    set loss loss + ((sim - 0.67) / 0.28) ^ 2
    set components components + 1
  ]

  let wheel-group patients with [mobility-class = "wheelchair"]
  if any? wheel-group [
    let sim mean [assisted-speed-mps] of wheel-group
    set loss loss + ((sim - 1.19) / 0.43) ^ 2
    set components components + 1
  ]

  let walk-group patients with [member? mobility-class ["ambulatory-adult" "ambulatory-elderly"]]
  if any? walk-group [
    let sim mean [unassisted-speed-mps] of walk-group
    set loss loss + ((sim - 1.07) / 0.48) ^ 2
    set components components + 1
  ]

  if components = 0 [report -1]
  report loss / components
end


to-report geoerg-pre-movement-pattern-loss
  if not run-complete? [report -1]
  let loss 0
  let components 0

  let bed-values [first-move-time-s] of patients with [
    member? mobility-class ["high-acuity-bed" "low-acuity-bed"] and first-move-time-s >= 0
  ]
  if not empty? bed-values [
    set loss loss + ((mean bed-values - 194) / 115) ^ 2
    set components components + 1
  ]

  let wheel-values [first-move-time-s] of patients with [
    mobility-class = "wheelchair" and first-move-time-s >= 0
  ]
  if not empty? wheel-values [
    set loss loss + ((mean wheel-values - 128) / 85) ^ 2
    set components components + 1
  ]

  let walk-values [first-move-time-s] of patients with [
    member? mobility-class ["ambulatory-adult" "ambulatory-elderly"] and first-move-time-s >= 0
  ]
  if not empty? walk-values [
    set loss loss + ((mean walk-values - 140) / 43) ^ 2
    set components components + 1
  ]

  if components = 0 [report -1]
  report loss / components
end


to-report geoerg-component-calibration-loss
  let speed-loss geoerg-speed-calibration-loss
  let pre-loss geoerg-pre-movement-pattern-loss
  if speed-loss < 0 or pre-loss < 0 [report -1]
  report speed-loss + pre-loss
end


to-report mean-staff-free-speed-mps
  let staff-group turtles with [member? role ["nurse" "doctor" "receptionist"]]
  if not any? staff-group [report -1]
  report mean [unassisted-speed-mps] of staff-group
end


to-report mean-ambulatory-adult-speed-mps
  let adult-group patients with [mobility-class = "ambulatory-adult"]
  if not any? adult-group [report -1]
  report mean [unassisted-speed-mps] of adult-group
end


to-report mean-staff-alarm-response-s
  let staff-group turtles with [member? role ["nurse" "doctor" "receptionist"]]
  if not any? staff-group [report -1]
  report mean [alarm-response-s] of staff-group
end


to-report mean-ambulatory-adult-pre-movement-s
  let adult-group patients with [
    mobility-class = "ambulatory-adult" and first-move-time-s >= 0
  ]
  if not any? adult-group [report -1]
  report mean [first-move-time-s] of adult-group
end


to-report rahouti-independent-validation-loss
 
  if not run-complete? [report -1]

  let staff-speed mean-staff-free-speed-mps
  let adult-speed mean-ambulatory-adult-speed-mps
  let staff-response mean-staff-alarm-response-s
  let adult-pre mean-ambulatory-adult-pre-movement-s
  if min (list staff-speed adult-speed staff-response adult-pre) < 0 [report -1]

  let loss ((staff-speed - 1.06) / 0.15) ^ 2
  set loss loss + ((adult-speed - 0.93) / 0.20) ^ 2


  if staff-response < 8 [set loss loss + ((8 - staff-response) / 20) ^ 2]
  if staff-response > 141 [set loss loss + ((staff-response - 141) / 20) ^ 2]
  if adult-pre < 8 [set loss loss + ((8 - adult-pre) / 15) ^ 2]
  if adult-pre > 63 [set loss loss + ((adult-pre - 63) / 15) ^ 2]

  report loss / 4
end


to-report rahouti-independent-validation-pass?
  if not run-complete? [report false]
  let staff-group (turtles with [member? role ["nurse" "doctor" "receptionist"]])
  let adult-group (patients with [
    mobility-class = "ambulatory-adult" and first-move-time-s >= 0
  ])
  if not any? staff-group or not any? adult-group [report false]

  let staff-speed mean [unassisted-speed-mps] of staff-group
  let adult-speed mobility-mean-free-speed-mps "ambulatory-adult"
  let staff-response-values [alarm-response-s] of staff-group
  let adult-pre-values [first-move-time-s] of adult-group

  report
    abs (staff-speed - 1.06) <= 0.15 and
    adult-speed >= 0.70 and adult-speed <= 1.20 and
    min staff-response-values >= 8 and
    max staff-response-values <= 141 and
    min adult-pre-values >= 8 and max adult-pre-values <= (63 + seconds-per-tick)
end


to-report case-calibration-loss
  if not run-complete? [report -1]
  let loss 0
  let components 0

  if target-mean-time-s >= 0 [
    set loss loss + ((mean-evacuation-time-s - target-mean-time-s) /
      max (list 1 target-mean-time-s)) ^ 2
    set components components + 1
  ]
  if target-p95-time-s >= 0 [
    set loss loss + ((p95-evacuation-time-s - target-p95-time-s) /
      max (list 1 target-p95-time-s)) ^ 2
    set components components + 1
  ]
  if target-complete-time-s >= 0 and complete-evacuation-time-s >= 0 [
    set loss loss + ((complete-evacuation-time-s - target-complete-time-s) /
      max (list 1 target-complete-time-s)) ^ 2
    set components components + 1
  ]
  if target-exit1-share-pct >= 0 and evacuated-count > 0 [
    let simulated-share 100 * exit-use-count 1 / evacuated-count
    set loss loss + ((simulated-share - target-exit1-share-pct) / 100) ^ 2
    set components components + 1
  ]

  if components = 0 [report -1]
  report loss / components
end


to-report obstacle-map-signature
  report sum [
    (pxcor + 64) * 1009 + (pycor + 32) * 1013
  ] of patches with [cell-kind = "temporary-obstacle"]
end


to-report population-signature
  report sum [
    (who + 1) * 1009 +
    round ((initial-xcor + 64) * 100) +
    round ((initial-ycor + 32) * 10) +
    round (assisted-speed-mps * 1000) +
    round (unassisted-speed-mps * 1000) +
    round preparation-required-s
  ] of turtles
end


to-report setup-diagnostic
  report (list
    setup-status
    setup-checkpoint
    initial-population
    count turtles
    verification-status
    obstacle-generation-attempts)
end


to-report mean-resource-reallocation-gain-m
  if resource-reallocations-count = 0 [report 0]
  report resource-reallocation-distance-saved-m / resource-reallocations-count
end

to-report model-scope-note
  report "UPU triage + independent mobility + adaptive route feedback + closed-loop nursing reallocation + Geoerg-aligned pre-movement; no physical fire/smoke/structural hazard propagation."
end

